,{"stream_name":"stdout","time":146.368618596,"data":"# ===== ga_ecbm.py (file mới) =====\n"}
,{"stream_name":"stdout","time":146.368622033,"data":"\"\"\"GA-ECBM (Gated Additive ECBM) đặt trong code ECBM gốc (xmed-lab/ECBM, commit d38c43a).\n"}
,{"stream_name":"stdout","time":146.368625782,"data":"\n"}
,{"stream_name":"stdout","time":146.368633808,"data":"Giữ nguyên của tác giả: backbone ResNet101, nhánh ảnh → nhãn E_class và nhánh ảnh → concept E_concept của EBM_GL.\n"}
,{"stream_name":"stdout","time":146.368637138,"data":"Thay: E_global(c, y) = −(b_y + Σ_k θ_{y,k}·c_k), tức bảng điểm cộng tính thay cho MLP trên cả vector concept.\n"}
,{"stream_name":"stdout","time":146.368639734,"data":"Nhờ cộng tính, p(y | x, concept đã biết) và p(c_k | x, …) tính chính xác bằng công thức đóng, không cần tối ưu gradient.\n"}
,{"stream_name":"stdout","time":146.368642502,"data":"Khi can thiệp k nhóm concept, nhánh ảnh nhân với cổng w(k) = exp(−Σ_{j≤k} softplus(a_j)), w(0) = 1.\n"}
,{"stream_name":"stdout","time":146.368645044,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":146.368647227,"data":"import os\n"}
,{"stream_name":"stdout","time":146.368649381,"data":"\n"}
,{"stream_name":"stdout","time":146.368651468,"data":"import torch\n"}
,{"stream_name":"stdout","time":146.368653587,"data":"import torch.nn as nn\n"}
,{"stream_name":"stdout","time":146.368655728,"data":"import torch.nn.functional as F\n"}
,{"stream_name":"stdout","time":146.368657889,"data":"\n"}
,{"stream_name":"stdout","time":146.368660005,"data":"from data.cub import CONCEPT_GROUP_MAP\n"}
,{"stream_name":"stdout","time":146.368662309,"data":"from networks.EBM import ECBM\n"}
,{"stream_name":"stdout","time":146.368664484,"data":"\n"}
,{"stream_name":"stdout","time":146.368666584,"data":"GROUPS = [list(indices) for indices in CONCEPT_GROUP_MAP.values()]   # 28 nhóm, như phần can thiệp theo nhóm của tác giả\n"}
,{"stream_name":"stdout","time":146.368669115,"data":"GATE_INIT = float(os.environ.get(\"GA_GATE_INIT\", \"-3.1\"))             # softplus(−3.1) ≈ 0.044 → w(28) ≈ 0.29\n"}
,{"stream_name":"stdout","time":146.368671646,"data":"\n"}
,{"stream_name":"stdout","time":146.368673705,"data":"\n"}
,{"stream_name":"stdout","time":146.368675789,"data":"class GAECBM(ECBM):\n"}
,{"stream_name":"stdout","time":146.368677964,"data":"    def __init__(self, args, emb_size, cpt_size, hid_size, n_classes):\n"}
,{"stream_name":"stdout","time":146.368680198,"data":"        super().__init__(args, emb_size=emb_size, cpt_size=cpt_size, hid_size=hid_size, n_classes=n_classes)\n"}
,{"stream_name":"stdout","time":146.368682494,"data":"        head = self.energy_model\n"}
,{"stream_name":"stdout","time":146.368688183,"data":"        del head.concept_proj, head.fc_c, head.classifier_cy        # MLP E_global của tác giả: không dùng nữa\n"}
,{"stream_name":"stdout","time":146.368690836,"data":"        self.theta = nn.Parameter(torch.zeros(n_classes, cpt_size))  # θ_{y,k}: điểm của concept k = 1 cho loài y\n"}
,{"stream_name":"stdout","time":146.368693331,"data":"        self.label_bias = nn.Parameter(torch.zeros(n_classes))       # b_y\n"}
,{"stream_name":"stdout","time":146.368695586,"data":"        self.gate_steps = nn.Parameter(torch.full((len(GROUPS),), GATE_INIT))\n"}
,{"stream_name":"stdout","time":146.368697833,"data":"        group_of = torch.zeros(cpt_size, dtype=torch.long)\n"}
,{"stream_name":"stdout","time":146.368700031,"data":"        for g, indices in enumerate(GROUPS):\n"}
,{"stream_name":"stdout","time":146.368702236,"data":"            group_of[indices] = g\n"}
,{"stream_name":"stdout","time":146.368704418,"data":"        self.register_buffer(\"group_of\", group_of, persistent=False)\n"}
,{"stream_name":"stdout","time":146.368706723,"data":"\n"}
,{"stream_name":"stdout","time":146.368708784,"data":"    def energies(self, images):\n"}
,{"stream_name":"stdout","time":146.368710974,"data":"        \"\"\"E_class [B, C] và E_concept [B, K, 2] của tác giả; E_concept[..., s] là năng lượng của trạng thái s.\"\"\"\n"}
,{"stream_name":"stdout","time":146.368713759,"data":"        emb = self.backbone(images)\n"}
,{"stream_name":"stdout","time":146.368715927,"data":"        e_class, _, e_concept = self.energy_model(emb, None, True, use_cy=False)\n"}
,{"stream_name":"stdout","time":146.368718177,"data":"        return e_class, e_concept\n"}
,{"stream_name":"stdout","time":146.368720347,"data":"\n"}
,{"stream_name":"stdout","time":146.368722478,"data":"    def gate(self, verified_groups):\n"}
,{"stream_name":"stdout","time":146.368724654,"data":"        w = torch.exp(-torch.cat([self.gate_steps.new_zeros(1), torch.cumsum(F.softplus(self.gate_steps), 0)]))\n"}
,{"stream_name":"stdout","time":146.368726937,"data":"        return w[verified_groups]\n"}
,{"stream_name":"stdout","time":146.368733773,"data":"\n"}
,{"stream_name":"stdout","time":146.368735956,"data":"    def global_score(self, concepts):\n"}
,{"stream_name":"stdout","time":146.368738146,"data":"        \"\"\"−E_global(c, y) cho mọi y: [B, C].\"\"\"\n"}
,{"stream_name":"stdout","time":146.368740559,"data":"        return self.label_bias + concepts.float() @ self.theta.t()\n"}
,{"stream_name":"stdout","time":146.36874278,"data":"\n"}
,{"stream_name":"stdout","time":146.368744856,"data":"    def posterior(self, e_class, e_concept, mask=None, values=None, class_weight=None):\n"}
,{"stream_name":"stdout","time":146.368747115,"data":"        \"\"\"log p(y | x, c_S) [B, C] và p(c_k = 1 | x, c_S) [B, K]; tính ở FP32.\"\"\"\n"}
,{"stream_name":"stdout","time":146.368749984,"data":"        e_class, e_concept = e_class.float(), e_concept.float()\n"}
,{"stream_name":"stdout","time":146.368752231,"data":"        t1 = -e_concept[..., 1][:, None, :] + self.theta[None]          # [B, C, K]\n"}
,{"stream_name":"stdout","time":146.368754504,"data":"        t0 = (-e_concept[..., 0])[:, None, :].expand_as(t1)\n"}
,{"stream_name":"stdout","time":146.368756711,"data":"        per_concept = torch.logaddexp(t0, t1)\n"}
,{"stream_name":"stdout","time":146.368758956,"data":"        p1_given_y = torch.sigmoid(t1 - t0)\n"}
,{"stream_name":"stdout","time":146.368761159,"data":"        if mask is not None:\n"}
,{"stream_name":"stdout","time":146.368763325,"data":"            observed = torch.where(values[:, None, :].bool(), t1, t0)\n"}
,{"stream_name":"stdout","time":146.368767992,"data":"            per_concept = torch.where(mask[:, None, :], observed, per_concept)\n"}
,{"stream_name":"stdout","time":146.368770478,"data":"            p1_given_y = torch.where(mask[:, None, :], values[:, None, :].float(), p1_given_y)\n"}
,{"stream_name":"stdout","time":146.368772721,"data":"        weight = 1.0 if class_weight is None else class_weight.float()[:, None]\n"}
,{"stream_name":"stdout","time":146.368775527,"data":"        log_p_y = (-weight * e_class + self.label_bias[None] + per_concept.sum(-1)).log_softmax(-1)\n"}
,{"stream_name":"stdout","time":146.368777897,"data":"        return log_p_y, (log_p_y.exp()[:, :, None] * p1_given_y).sum(1)\n"}
,{"stream_name":"stdout","time":146.368780124,"data":"\n"}
,{"stream_name":"stdout","time":146.368782186,"data":"\n"}
,{"stream_name":"stdout","time":146.368784231,"data":"def ga_losses(model, loss_label, loss_concept, images, labels, concepts, weights=(3, 1, 1)):\n"}
,{"stream_name":"stdout","time":146.36878649,"data":"    \"\"\"Loss của GA-ECBM cho một batch.\n"}
,{"stream_name":"stdout","time":146.368788796,"data":"\n"}
,{"stream_name":"stdout","time":146.368790857,"data":"    Trả về (loss train, loss validation kiểu tác giả, các thành phần, (e_class, e_concept, concept sạch)).\n"}
,{"stream_name":"stdout","time":146.36879334,"data":"    Loss gốc 3 : 1 : 1 gọi đúng hàm loss và cy_augment của tác giả. Trong forward gốc, cy_augment sửa thẳng tensor concept\n"}
,{"stream_name":"stdout","time":146.368795883,"data":"    của batch, nên L_xc của tác giả cũng tính trên concept đã xáo trộn; ở đây giữ nguyên hành vi đó cho phần loss gốc.\n"}
,{"stream_name":"stdout","time":146.368798599,"data":"    Ba loss mới dùng concept sạch (bản sao lấy trước khi xáo trộn).\n"}
,{"stream_name":"stdout","time":146.368801037,"data":"    \"\"\"\n"}
,{"stream_name":"stdout","time":146.368803181,"data":"    clean = concepts.clone()\n"}
,{"stream_name":"stdout","time":146.36880537,"data":"    head = model.energy_model\n"}
,{"stream_name":"stdout","time":146.368807539,"data":"    e_class, e_concept = model.energies(images)\n"}
,{"stream_name":"stdout","time":146.368809743,"data":"    perturbed = head.cy_augment(c_gt=concepts.unsqueeze(-1), permute_ratio=head.cy_concept_perturb_prob,\n"}
,{"stream_name":"stdout","time":146.368814372,"data":"                                permute_prob=head.cy_sample_perturb_prob).squeeze(-1)\n"}
,{"stream_name":"stdout","time":146.368816675,"data":"    loss_xy = loss_label(e_class, labels)\n"}
,{"stream_name":"stdout","time":146.368818933,"data":"    loss_cy = loss_label(-model.global_score(perturbed), labels)       # EBMLoss_label nhận năng lượng\n"}
,{"stream_name":"stdout","time":146.368821332,"data":"    loss_xc = loss_concept(e_concept, concepts)\n"}
,{"stream_name":"stdout","time":146.368823678,"data":"    w_xy, w_xc, w_cy = weights\n"}
,{"stream_name":"stdout","time":146.36882586,"data":"    base = w_xy * loss_xy + w_xc * loss_xc + w_cy * loss_cy\n"}
,{"stream_name":"stdout","time":146.368828102,"data":"\n"}
,{"stream_name":"stdout","time":146.368830206,"data":"    device_type = \"cuda\" if images.is_cuda else \"cpu\"\n"}
,{"stream_name":"stdout","time":146.368832664,"data":"    with torch.autocast(device_type=device_type, enabled=False):\n"}
,{"stream_name":"stdout","time":146.368834912,"data":"        count, n_groups = len(labels), len(GROUPS)\n"}
,{"stream_name":"stdout","time":146.368837196,"data":"        log_p_y, p_c = model.posterior(e_class, e_concept)\n"}
,{"stream_name":"stdout","time":146.36883946,"data":"        joint = F.nll_loss(log_p_y, labels) + F.binary_cross_entropy(p_c.clamp(1e-6, 1 - 1e-6), clean.float())\n"}
,{"stream_name":"stdout","time":146.36884411,"data":"        groups = torch.rand(count, n_groups, device=images.device) \u003c torch.rand(count, 1, device=images.device)\n"}
,{"stream_name":"stdout","time":146.368846867,"data":"        drop = torch.rand(count, device=images.device) \u003c 0.5                  # nửa số ca tắt hẳn nhánh ảnh\n"}
,{"stream_name":"stdout","time":146.368849409,"data":"        k = groups.sum(1)\n"}
,{"stream_name":"stdout","time":146.368851607,"data":"        w_k = torch.where(drop, torch.zeros_like(k, dtype=torch.float), model.gate(k))\n"}
,{"stream_name":"stdout","time":146.368854223,"data":"        log_int, _ = model.posterior(e_class, e_concept, groups[:, model.group_of], clean, w_k)\n"}
,{"stream_name":"stdout","time":146.368856549,"data":"        loss_int = F.nll_loss(log_int, labels, reduction=\"none\")\n"}
,{"stream_name":"stdout","time":146.36885886,"data":"        extra = torch.multinomial((~groups).float() + 1e-9, 1).squeeze(1)      # xác minh thêm 1 nhóm\n"}
,{"stream_name":"stdout","time":146.368861258,"data":"        groups_more = groups.clone()\n"}
,{"stream_name":"stdout","time":146.36886345,"data":"        groups_more[torch.arange(count, device=images.device), extra] = True\n"}
,{"stream_name":"stdout","time":146.368865728,"data":"        k_more = groups_more.sum(1)\n"}
,{"stream_name":"stdout","time":146.368867918,"data":"        w_more = torch.where(drop, torch.zeros_like(k_more, dtype=torch.float), model.gate(k_more))\n"}
,{"stream_name":"stdout","time":146.368870209,"data":"        log_more, _ = model.posterior(e_class, e_concept, groups_more[:, model.group_of], clean, w_more)\n"}
,{"stream_name":"stdout","time":146.36887252,"data":"        mono = F.relu(F.nll_loss(log_more, labels, reduction=\"none\") - loss_int).mean()\n"}
,{"stream_name":"stdout","time":146.368874845,"data":"    total = base + joint + loss_int.mean() + mono\n"}
,{"stream_name":"stdout","time":146.368877057,"data":"    val_like = loss_xc + loss_xy + loss_cy                                   # như validation_step của tác giả\n"}
,{"stream_name":"stdout","time":146.368879457,"data":"    parts = {\"xy\": loss_xy, \"xc\": loss_xc, \"cy\": loss_cy, \"joint\": joint, \"int\": loss_int.mean(), \"mono\": mono}\n"}
,{"stream_name":"stdout","time":146.368882112,"data":"    return total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c)\n"}
,{"stream_name":"stdout","time":146.368884393,"data":"\n"}
,{"stream_name":"stdout","time":146.368886484,"data":"# ===== ga_litmodel.py (file mới) =====\n"}
,{"stream_name":"stdout","time":146.368888756,"data":"\"\"\"LightningModule của GA-ECBM: kế thừa LitModel của tác giả, giữ nguyên optimizer, scheduler và cách log.\n"}
,{"stream_name":"stdout","time":146.368891309,"data":"\n"}
,{"stream_name":"stdout","time":146.368893414,"data":"main.py chỉ đổi một dòng import để dùng lớp này; mọi thứ khác (dữ liệu, sampler, ModelCheckpoint, số epoch) giữ nguyên.\n"}
,{"stream_name":"stdout","time":146.368896116,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":146.368898295,"data":"import logging\n"}
,{"stream_name":"stdout","time":146.368900459,"data":"import os\n"}
,{"stream_name":"stdout","time":146.368902601,"data":"\n"}
,{"stream_name":"stdout","time":146.368904683,"data":"import torch\n"}
,{"stream_name":"stdout","time":146.368906827,"data":"\n"}
,{"stream_name":"stdout","time":146.368908912,"data":"from LitModel import LitModel\n"}
,{"stream_name":"stdout","time":146.368911122,"data":"from ga_ecbm import GATE_INIT, GROUPS, GAECBM, ga_losses\n"}
,{"stream_name":"stdout","time":146.368915383,"data":"\n"}
,{"stream_name":"stdout","time":146.36891757,"data":"\n"}
,{"stream_name":"stdout","time":146.368919647,"data":"def _accuracy(pred, target):\n"}
,{"stream_name":"stdout","time":146.368921847,"data":"    return (pred == target).float().mean()\n"}
,{"stream_name":"stdout","time":146.368924052,"data":"\n"}
,{"stream_name":"stdout","time":146.36892613,"data":"\n"}
,{"stream_name":"stdout","time":146.368928202,"data":"class GALitModel(LitModel):\n"}
,{"stream_name":"stdout","time":146.368930396,"data":"    def __init__(self, logdir, args):\n"}
,{"stream_name":"stdout","time":146.368932621,"data":"        super().__init__(logdir, args)\n"}
,{"stream_name":"stdout","time":146.368934828,"data":"        self.network = GAECBM(args=args, emb_size=args.emb_size, cpt_size=args.cpt_size, hid_size=args.hid_size,\n"}
,{"stream_name":"stdout","time":146.368937155,"data":"                              n_classes=args.n_classes)\n"}
,{"stream_name":"stdout","time":146.368939422,"data":"        logging.info(\"GA-ECBM: gate_init=%s, groups=%d\", GATE_INIT, len(GROUPS))   # dấu để notebook nhận ra lần chạy GA\n"}
,{"stream_name":"stdout","time":146.368941927,"data":"\n"}
,{"stream_name":"stdout","time":146.368944017,"data":"    def _step(self, batch, stage):\n"}
,{"stream_name":"stdout","time":146.368946252,"data":"        images, labels, concepts = batch\n"}
,{"stream_name":"stdout","time":146.368948664,"data":"        total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c) = ga_losses(\n"}
,{"stream_name":"stdout","time":146.368951005,"data":"            self.network, self.loss_label, self.loss_concept, images, labels, concepts,\n"}
,{"stream_name":"stdout","time":146.368953272,"data":"            (self.lambda_xy, self.lambda_xc, self.lambda_cy))\n"}
,{"stream_name":"stdout","time":146.368955494,"data":"        pred_c_direct = torch.argmin(e_concept, 2)\n"}
,{"stream_name":"stdout","time":146.368957839,"data":"        pred_c_post = (p_c \u003e 0.5).long()\n"}
,{"stream_name":"stdout","time":146.368960129,"data":"        values = {\n"}
,{"stream_name":"stdout","time":146.368962344,"data":"            # như tác giả: đọc trực tiếp năng lượng, concept so với tensor của batch (đã bị cy_augment sửa)\n"}
,{"stream_name":"stdout","time":146.368964999,"data":"            f\"accuracy_{stage}_y_xy\": _accuracy(torch.argmin(e_class, 1), labels),\n"}
,{"stream_name":"stdout","time":146.36896734,"data":"            f\"accuracy_{stage}_c\": _accuracy(pred_c_direct, concepts),\n"}
,{"stream_name":"stdout","time":146.368969634,"data":"            f\"accuracy_{stage}_c_overall\": (pred_c_direct == concepts).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":146.368971962,"data":"            # GA-ECBM: suy luận chính xác, so với concept sạch\n"}
,{"stream_name":"stdout","time":146.368974329,"data":"            f\"accuracy_{stage}_y_post\": _accuracy(log_p_y.argmax(1), labels),\n"}
,{"stream_name":"stdout","time":146.368976644,"data":"            f\"accuracy_{stage}_c_post\": _accuracy(pred_c_post, clean),\n"}
,{"stream_name":"stdout","time":146.368978962,"data":"            f\"accuracy_{stage}_c_overall_post\": (pred_c_post == clean).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":146.368981314,"data":"        }\n"}
,{"stream_name":"stdout","time":146.368983458,"data":"        for name, value in values.items():\n"}
,{"stream_name":"stdout","time":146.368985662,"data":"            self.log(name, value, on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":146.36898789399999,"data":"        return total, val_like, parts, values\n"}
,{"stream_name":"stdout","time":146.368990159,"data":"\n"}
,{"stream_name":"stdout","time":146.368994309,"data":"    def training_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":146.368996605,"data":"        total, _, parts, _ = self._step(batch, \"train\")\n"}
,{"stream_name":"stdout","time":146.368998926,"data":"        self.log(\"epoch_loss\", total, on_epoch=True)                 # scheduler của tác giả theo dõi epoch_loss_epoch\n"}
,{"stream_name":"stdout","time":146.369001414,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":146.369003626,"data":"            self.log(f\"epoch_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":146.369005937,"data":"        if batch_idx == 0:\n"}
,{"stream_name":"stdout","time":146.3690082,"data":"            w = self.network.gate(torch.tensor([0, 7, 14, 28], device=self.device))\n"}
,{"stream_name":"stdout","time":146.369010758,"data":"            self.log(\"gate_w_7\", w[1], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":146.369013133,"data":"            self.log(\"gate_w_28\", w[3], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":146.369015444,"data":"        return total\n"}
,{"stream_name":"stdout","time":146.369017612,"data":"\n"}
,{"stream_name":"stdout","time":146.36901971,"data":"    def validation_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":146.369022015,"data":"        _, val_like, parts, _ = self._step(batch, \"val\")\n"}
,{"stream_name":"stdout","time":146.369024331,"data":"        self.log(\"epoch_val_loss\", val_like, on_epoch=True)         # ModelCheckpoint theo dõi khóa này, như tác giả\n"}
,{"stream_name":"stdout","time":146.369027193,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":146.36902943,"data":"            self.log(f\"epoch_val_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":146.369031809,"data":"        return val_like\n"}
,{"stream_name":"stdout","time":146.369033985,"data":"\n"}
,{"stream_name":"stdout","time":146.36903607,"data":"    def test_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":146.369038271,"data":"        _, _, _, values = self._step(batch, \"test\")\n"}
,{"stream_name":"stdout","time":146.369040622,"data":"        return [values[\"accuracy_test_c_overall_post\"].item(), values[\"accuracy_test_c_post\"].item(),\n"}
,{"stream_name":"stdout","time":146.369043031,"data":"                values[\"accuracy_test_y_xy\"].item(), values[\"accuracy_test_y_post\"].item()]\n"}
,{"stream_name":"stdout","time":146.36904549,"data":"\n"}
,{"stream_name":"stdout","time":146.36904758,"data":"    def test_epoch_end(self, outputs):\n"}
,{"stream_name":"stdout","time":146.36904983,"data":"        mean = torch.tensor(outputs).mean(0)\n"}
,{"stream_name":"stdout","time":146.369052072,"data":"        for name, value in zip((\"accuracy_test_c_overall_post\", \"accuracy_test_c_post\", \"accuracy_test_y_xy\",\n"}
,{"stream_name":"stdout","time":146.369054537,"data":"                                \"accuracy_test_y_post\"), mean):\n"}
,{"stream_name":"stdout","time":146.369056853,"data":"            logging.info(\"%s: %s\", name, float(value))\n"}
,{"stream_name":"stdout","time":146.369059162,"data":"\n"}
