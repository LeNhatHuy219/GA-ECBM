,{"stream_name":"stdout","time":123.721642835,"data":"# ===== ga_ecbm.py (file mới) =====\n"}
,{"stream_name":"stdout","time":123.721646435,"data":"\"\"\"GA-ECBM (Gated Additive ECBM) đặt trong code ECBM gốc (xmed-lab/ECBM, commit d38c43a).\n"}
,{"stream_name":"stdout","time":123.72165058,"data":"\n"}
,{"stream_name":"stdout","time":123.721653968,"data":"Giữ nguyên của tác giả: backbone ResNet101, nhánh ảnh → nhãn E_class và nhánh ảnh → concept E_concept của EBM_GL.\n"}
,{"stream_name":"stdout","time":123.721658067,"data":"Thay: E_global(c, y) = −(b_y + Σ_k θ_{y,k}·c_k), tức bảng điểm cộng tính thay cho MLP trên cả vector concept.\n"}
,{"stream_name":"stdout","time":123.72166204,"data":"Nhờ cộng tính, p(y | x, concept đã biết) và p(c_k | x, …) tính chính xác bằng công thức đóng, không cần tối ưu gradient.\n"}
,{"stream_name":"stdout","time":123.721666419,"data":"Khi can thiệp k nhóm concept, nhánh ảnh nhân với cổng w(k) = exp(−Σ_{j≤k} softplus(a_j)), w(0) = 1.\n"}
,{"stream_name":"stdout","time":123.721670337,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":123.721673552,"data":"import os\n"}
,{"stream_name":"stdout","time":123.721677027,"data":"\n"}
,{"stream_name":"stdout","time":123.721680438,"data":"import torch\n"}
,{"stream_name":"stdout","time":123.721683497,"data":"import torch.nn as nn\n"}
,{"stream_name":"stdout","time":123.721686598,"data":"import torch.nn.functional as F\n"}
,{"stream_name":"stdout","time":123.721689801,"data":"\n"}
,{"stream_name":"stdout","time":123.721693008,"data":"from data.cub import CONCEPT_GROUP_MAP\n"}
,{"stream_name":"stdout","time":123.721696371,"data":"from networks.EBM import ECBM\n"}
,{"stream_name":"stdout","time":123.72169999,"data":"\n"}
,{"stream_name":"stdout","time":123.721703335,"data":"GROUPS = [list(indices) for indices in CONCEPT_GROUP_MAP.values()]   # 28 nhóm, như phần can thiệp theo nhóm của tác giả\n"}
,{"stream_name":"stdout","time":123.72170744,"data":"GATE_INIT = float(os.environ.get(\"GA_GATE_INIT\", \"-3.1\"))             # softplus(−3.1) ≈ 0.044 → w(28) ≈ 0.29\n"}
,{"stream_name":"stdout","time":123.721711472,"data":"\n"}
,{"stream_name":"stdout","time":123.721714767,"data":"\n"}
,{"stream_name":"stdout","time":123.72171864,"data":"class GAECBM(ECBM):\n"}
,{"stream_name":"stdout","time":123.721722272,"data":"    def __init__(self, args, emb_size, cpt_size, hid_size, n_classes):\n"}
,{"stream_name":"stdout","time":123.721725489,"data":"        super().__init__(args, emb_size=emb_size, cpt_size=cpt_size, hid_size=hid_size, n_classes=n_classes)\n"}
,{"stream_name":"stdout","time":123.72172934,"data":"        head = self.energy_model\n"}
,{"stream_name":"stdout","time":123.721734023,"data":"        del head.concept_proj, head.fc_c, head.classifier_cy        # MLP E_global của tác giả: không dùng nữa\n"}
,{"stream_name":"stdout","time":123.721737779,"data":"        self.theta = nn.Parameter(torch.zeros(n_classes, cpt_size))  # θ_{y,k}: điểm của concept k = 1 cho loài y\n"}
,{"stream_name":"stdout","time":123.721748738,"data":"        self.label_bias = nn.Parameter(torch.zeros(n_classes))       # b_y\n"}
,{"stream_name":"stdout","time":123.721752347,"data":"        self.gate_steps = nn.Parameter(torch.full((len(GROUPS),), GATE_INIT))\n"}
,{"stream_name":"stdout","time":123.721755828,"data":"        group_of = torch.zeros(cpt_size, dtype=torch.long)\n"}
,{"stream_name":"stdout","time":123.721759215,"data":"        for g, indices in enumerate(GROUPS):\n"}
,{"stream_name":"stdout","time":123.721762977,"data":"            group_of[indices] = g\n"}
,{"stream_name":"stdout","time":123.721766538,"data":"        self.register_buffer(\"group_of\", group_of, persistent=False)\n"}
,{"stream_name":"stdout","time":123.721770255,"data":"\n"}
,{"stream_name":"stdout","time":123.721773496,"data":"    def energies(self, images):\n"}
,{"stream_name":"stdout","time":123.721776905,"data":"        \"\"\"E_class [B, C] và E_concept [B, K, 2] của tác giả; E_concept[..., s] là năng lượng của trạng thái s.\"\"\"\n"}
,{"stream_name":"stdout","time":123.721781145,"data":"        emb = self.backbone(images)\n"}
,{"stream_name":"stdout","time":123.721784602,"data":"        e_class, _, e_concept = self.energy_model(emb, None, True, use_cy=False)\n"}
,{"stream_name":"stdout","time":123.721788192,"data":"        return e_class, e_concept\n"}
,{"stream_name":"stdout","time":123.721791129,"data":"\n"}
,{"stream_name":"stdout","time":123.721794695,"data":"    def gate(self, verified_groups):\n"}
,{"stream_name":"stdout","time":123.721798117,"data":"        w = torch.exp(-torch.cat([self.gate_steps.new_zeros(1), torch.cumsum(F.softplus(self.gate_steps), 0)]))\n"}
,{"stream_name":"stdout","time":123.721801828,"data":"        return w[verified_groups]\n"}
,{"stream_name":"stdout","time":123.721805162,"data":"\n"}
,{"stream_name":"stdout","time":123.721808358,"data":"    def global_score(self, concepts):\n"}
,{"stream_name":"stdout","time":123.721811891,"data":"        \"\"\"−E_global(c, y) cho mọi y: [B, C].\"\"\"\n"}
,{"stream_name":"stdout","time":123.721815453,"data":"        return self.label_bias + concepts.float() @ self.theta.t()\n"}
,{"stream_name":"stdout","time":123.721818863,"data":"\n"}
,{"stream_name":"stdout","time":123.721822081,"data":"    def posterior(self, e_class, e_concept, mask=None, values=None, class_weight=None):\n"}
,{"stream_name":"stdout","time":123.721825674,"data":"        \"\"\"log p(y | x, c_S) [B, C] và p(c_k = 1 | x, c_S) [B, K]; tính ở FP32.\"\"\"\n"}
,{"stream_name":"stdout","time":123.72182949,"data":"        e_class, e_concept = e_class.float(), e_concept.float()\n"}
,{"stream_name":"stdout","time":123.721832622,"data":"        t1 = -e_concept[..., 1][:, None, :] + self.theta[None]          # [B, C, K]\n"}
,{"stream_name":"stdout","time":123.721836292,"data":"        t0 = (-e_concept[..., 0])[:, None, :].expand_as(t1)\n"}
,{"stream_name":"stdout","time":123.721839959,"data":"        per_concept = torch.logaddexp(t0, t1)\n"}
,{"stream_name":"stdout","time":123.721843357,"data":"        p1_given_y = torch.sigmoid(t1 - t0)\n"}
,{"stream_name":"stdout","time":123.721846677,"data":"        if mask is not None:\n"}
,{"stream_name":"stdout","time":123.721849998,"data":"            observed = torch.where(values[:, None, :].bool(), t1, t0)\n"}
,{"stream_name":"stdout","time":123.721853262,"data":"            per_concept = torch.where(mask[:, None, :], observed, per_concept)\n"}
,{"stream_name":"stdout","time":123.72185676,"data":"            p1_given_y = torch.where(mask[:, None, :], values[:, None, :].float(), p1_given_y)\n"}
,{"stream_name":"stdout","time":123.721864192,"data":"        weight = 1.0 if class_weight is None else class_weight.float()[:, None]\n"}
,{"stream_name":"stdout","time":123.721868975,"data":"        log_p_y = (-weight * e_class + self.label_bias[None] + per_concept.sum(-1)).log_softmax(-1)\n"}
,{"stream_name":"stdout","time":123.721872627,"data":"        return log_p_y, (log_p_y.exp()[:, :, None] * p1_given_y).sum(1)\n"}
,{"stream_name":"stdout","time":123.721876051,"data":"\n"}
,{"stream_name":"stdout","time":123.72187902,"data":"\n"}
,{"stream_name":"stdout","time":123.721882245,"data":"def ga_losses(model, loss_label, loss_concept, images, labels, concepts, weights=(3, 1, 1)):\n"}
,{"stream_name":"stdout","time":123.721885773,"data":"    \"\"\"Loss của GA-ECBM cho một batch.\n"}
,{"stream_name":"stdout","time":123.721889402,"data":"\n"}
,{"stream_name":"stdout","time":123.721892622,"data":"    Trả về (loss train, loss validation kiểu tác giả, các thành phần, (e_class, e_concept, concept sạch)).\n"}
,{"stream_name":"stdout","time":123.721896485,"data":"    Loss gốc 3 : 1 : 1 gọi đúng hàm loss và cy_augment của tác giả. Trong forward gốc, cy_augment sửa thẳng tensor concept\n"}
,{"stream_name":"stdout","time":123.721900413,"data":"    của batch, nên L_xc của tác giả cũng tính trên concept đã xáo trộn; ở đây giữ nguyên hành vi đó cho phần loss gốc.\n"}
,{"stream_name":"stdout","time":123.72190466,"data":"    Ba loss mới dùng concept sạch (bản sao lấy trước khi xáo trộn).\n"}
,{"stream_name":"stdout","time":123.721908047,"data":"    \"\"\"\n"}
,{"stream_name":"stdout","time":123.721911398,"data":"    clean = concepts.clone()\n"}
,{"stream_name":"stdout","time":123.721915278,"data":"    head = model.energy_model\n"}
,{"stream_name":"stdout","time":123.721918582,"data":"    e_class, e_concept = model.energies(images)\n"}
,{"stream_name":"stdout","time":123.721921693,"data":"    perturbed = head.cy_augment(c_gt=concepts.unsqueeze(-1), permute_ratio=head.cy_concept_perturb_prob,\n"}
,{"stream_name":"stdout","time":123.721925442,"data":"                                permute_prob=head.cy_sample_perturb_prob).squeeze(-1)\n"}
,{"stream_name":"stdout","time":123.721928913,"data":"    loss_xy = loss_label(e_class, labels)\n"}
,{"stream_name":"stdout","time":123.721932381,"data":"    loss_cy = loss_label(-model.global_score(perturbed), labels)       # EBMLoss_label nhận năng lượng\n"}
,{"stream_name":"stdout","time":123.721936201,"data":"    loss_xc = loss_concept(e_concept, concepts)\n"}
,{"stream_name":"stdout","time":123.721939656,"data":"    w_xy, w_xc, w_cy = weights\n"}
,{"stream_name":"stdout","time":123.721942973,"data":"    base = w_xy * loss_xy + w_xc * loss_xc + w_cy * loss_cy\n"}
,{"stream_name":"stdout","time":123.721946443,"data":"\n"}
,{"stream_name":"stdout","time":123.721949691,"data":"    device_type = \"cuda\" if images.is_cuda else \"cpu\"\n"}
,{"stream_name":"stdout","time":123.721953406,"data":"    with torch.autocast(device_type=device_type, enabled=False):\n"}
,{"stream_name":"stdout","time":123.721956838,"data":"        count, n_groups = len(labels), len(GROUPS)\n"}
,{"stream_name":"stdout","time":123.721960303,"data":"        log_p_y, p_c = model.posterior(e_class, e_concept)\n"}
,{"stream_name":"stdout","time":123.721963748,"data":"        joint = F.nll_loss(log_p_y, labels) + F.binary_cross_entropy(p_c.clamp(1e-6, 1 - 1e-6), clean.float())\n"}
,{"stream_name":"stdout","time":123.721967377,"data":"        groups = torch.rand(count, n_groups, device=images.device) \u003c torch.rand(count, 1, device=images.device)\n"}
,{"stream_name":"stdout","time":123.721974028,"data":"        drop = torch.rand(count, device=images.device) \u003c 0.5                  # nửa số ca tắt hẳn nhánh ảnh\n"}
,{"stream_name":"stdout","time":123.721978076,"data":"        k = groups.sum(1)\n"}
,{"stream_name":"stdout","time":123.721981718,"data":"        w_k = torch.where(drop, torch.zeros_like(k, dtype=torch.float), model.gate(k))\n"}
,{"stream_name":"stdout","time":123.72198563,"data":"        log_int, _ = model.posterior(e_class, e_concept, groups[:, model.group_of], clean, w_k)\n"}
,{"stream_name":"stdout","time":123.721989068,"data":"        loss_int = F.nll_loss(log_int, labels, reduction=\"none\")\n"}
,{"stream_name":"stdout","time":123.721992722,"data":"        extra = torch.multinomial((~groups).float() + 1e-9, 1).squeeze(1)      # xác minh thêm 1 nhóm\n"}
,{"stream_name":"stdout","time":123.721996537,"data":"        groups_more = groups.clone()\n"}
,{"stream_name":"stdout","time":123.721999913,"data":"        groups_more[torch.arange(count, device=images.device), extra] = True\n"}
,{"stream_name":"stdout","time":123.722003381,"data":"        k_more = groups_more.sum(1)\n"}
,{"stream_name":"stdout","time":123.722006847,"data":"        w_more = torch.where(drop, torch.zeros_like(k_more, dtype=torch.float), model.gate(k_more))\n"}
,{"stream_name":"stdout","time":123.722010431,"data":"        log_more, _ = model.posterior(e_class, e_concept, groups_more[:, model.group_of], clean, w_more)\n"}
,{"stream_name":"stdout","time":123.722014085,"data":"        mono = F.relu(F.nll_loss(log_more, labels, reduction=\"none\") - loss_int).mean()\n"}
,{"stream_name":"stdout","time":123.722017456,"data":"    total = base + joint + loss_int.mean() + mono\n"}
,{"stream_name":"stdout","time":123.722020623,"data":"    val_like = loss_xc + loss_xy + loss_cy                                   # như validation_step của tác giả\n"}
,{"stream_name":"stdout","time":123.72202406,"data":"    parts = {\"xy\": loss_xy, \"xc\": loss_xc, \"cy\": loss_cy, \"joint\": joint, \"int\": loss_int.mean(), \"mono\": mono}\n"}
,{"stream_name":"stdout","time":123.722028828,"data":"    return total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c)\n"}
,{"stream_name":"stdout","time":123.722032279,"data":"\n"}
,{"stream_name":"stdout","time":123.722035474,"data":"# ===== ga_litmodel.py (file mới) =====\n"}
,{"stream_name":"stdout","time":123.72203897200001,"data":"\"\"\"LightningModule của GA-ECBM: kế thừa LitModel của tác giả, giữ nguyên optimizer, scheduler và cách log.\n"}
,{"stream_name":"stdout","time":123.722043136,"data":"\n"}
,{"stream_name":"stdout","time":123.722046357,"data":"main.py chỉ đổi một dòng import để dùng lớp này; mọi thứ khác (dữ liệu, sampler, ModelCheckpoint, số epoch) giữ nguyên.\n"}
,{"stream_name":"stdout","time":123.722050742,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":123.72205421,"data":"import logging\n"}
,{"stream_name":"stdout","time":123.72205738,"data":"import os\n"}
,{"stream_name":"stdout","time":123.722060654,"data":"\n"}
,{"stream_name":"stdout","time":123.722065782,"data":"import torch\n"}
,{"stream_name":"stdout","time":123.722069048,"data":"\n"}
,{"stream_name":"stdout","time":123.722072317,"data":"from LitModel import LitModel\n"}
,{"stream_name":"stdout","time":123.722075273,"data":"from ga_ecbm import GATE_INIT, GROUPS, GAECBM, ga_losses\n"}
,{"stream_name":"stdout","time":123.72207869,"data":"\n"}
,{"stream_name":"stdout","time":123.722081595,"data":"\n"}
,{"stream_name":"stdout","time":123.722084837,"data":"def _accuracy(pred, target):\n"}
,{"stream_name":"stdout","time":123.722088138,"data":"    return (pred == target).float().mean()\n"}
,{"stream_name":"stdout","time":123.72209476,"data":"\n"}
,{"stream_name":"stdout","time":123.722098123,"data":"\n"}
,{"stream_name":"stdout","time":123.722101358,"data":"class GALitModel(LitModel):\n"}
,{"stream_name":"stdout","time":123.722104702,"data":"    def __init__(self, logdir, args):\n"}
,{"stream_name":"stdout","time":123.722108095,"data":"        super().__init__(logdir, args)\n"}
,{"stream_name":"stdout","time":123.722111596,"data":"        self.network = GAECBM(args=args, emb_size=args.emb_size, cpt_size=args.cpt_size, hid_size=args.hid_size,\n"}
,{"stream_name":"stdout","time":123.722115473,"data":"                              n_classes=args.n_classes)\n"}
,{"stream_name":"stdout","time":123.722118848,"data":"        logging.info(\"GA-ECBM: gate_init=%s, groups=%d\", GATE_INIT, len(GROUPS))   # dấu để notebook nhận ra lần chạy GA\n"}
,{"stream_name":"stdout","time":123.722122799,"data":"\n"}
,{"stream_name":"stdout","time":123.722125997,"data":"    def _step(self, batch, stage):\n"}
,{"stream_name":"stdout","time":123.722129308,"data":"        images, labels, concepts = batch\n"}
,{"stream_name":"stdout","time":123.722132994,"data":"        total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c) = ga_losses(\n"}
,{"stream_name":"stdout","time":123.722136559,"data":"            self.network, self.loss_label, self.loss_concept, images, labels, concepts,\n"}
,{"stream_name":"stdout","time":123.722140079,"data":"            (self.lambda_xy, self.lambda_xc, self.lambda_cy))\n"}
,{"stream_name":"stdout","time":123.72214356,"data":"        pred_c_direct = torch.argmin(e_concept, 2)\n"}
,{"stream_name":"stdout","time":123.72214704,"data":"        pred_c_post = (p_c \u003e 0.5).long()\n"}
,{"stream_name":"stdout","time":123.722150544,"data":"        values = {\n"}
,{"stream_name":"stdout","time":123.722153828,"data":"            # như tác giả: đọc trực tiếp năng lượng, concept so với tensor của batch (đã bị cy_augment sửa)\n"}
,{"stream_name":"stdout","time":123.722157777,"data":"            f\"accuracy_{stage}_y_xy\": _accuracy(torch.argmin(e_class, 1), labels),\n"}
,{"stream_name":"stdout","time":123.722161413,"data":"            f\"accuracy_{stage}_c\": _accuracy(pred_c_direct, concepts),\n"}
,{"stream_name":"stdout","time":123.722164729,"data":"            f\"accuracy_{stage}_c_overall\": (pred_c_direct == concepts).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":123.722168321,"data":"            # GA-ECBM: suy luận chính xác, so với concept sạch\n"}
,{"stream_name":"stdout","time":123.722172235,"data":"            f\"accuracy_{stage}_y_post\": _accuracy(log_p_y.argmax(1), labels),\n"}
,{"stream_name":"stdout","time":123.722175829,"data":"            f\"accuracy_{stage}_c_post\": _accuracy(pred_c_post, clean),\n"}
,{"stream_name":"stdout","time":123.722179012,"data":"            f\"accuracy_{stage}_c_overall_post\": (pred_c_post == clean).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":123.722183098,"data":"        }\n"}
,{"stream_name":"stdout","time":123.7221866,"data":"        for name, value in values.items():\n"}
,{"stream_name":"stdout","time":123.722190138,"data":"            self.log(name, value, on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":123.722193742,"data":"        return total, val_like, parts, values\n"}
,{"stream_name":"stdout","time":123.722197033,"data":"\n"}
,{"stream_name":"stdout","time":123.722200238,"data":"    def training_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":123.722203653,"data":"        total, _, parts, _ = self._step(batch, \"train\")\n"}
,{"stream_name":"stdout","time":123.722210183,"data":"        self.log(\"epoch_loss\", total, on_epoch=True)                 # scheduler của tác giả theo dõi epoch_loss_epoch\n"}
,{"stream_name":"stdout","time":123.72221426,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":123.722217662,"data":"            self.log(f\"epoch_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":123.722221278,"data":"        if batch_idx == 0:\n"}
,{"stream_name":"stdout","time":123.72222463,"data":"            w = self.network.gate(torch.tensor([0, 7, 14, 28], device=self.device))\n"}
,{"stream_name":"stdout","time":123.722227763,"data":"            self.log(\"gate_w_7\", w[1], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":123.722247138,"data":"            self.log(\"gate_w_28\", w[3], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":123.722255645,"data":"        return total\n"}
,{"stream_name":"stdout","time":123.72225916,"data":"\n"}
,{"stream_name":"stdout","time":123.722262317,"data":"    def validation_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":123.722265974,"data":"        _, val_like, parts, _ = self._step(batch, \"val\")\n"}
,{"stream_name":"stdout","time":123.722269767,"data":"        self.log(\"epoch_val_loss\", val_like, on_epoch=True)         # ModelCheckpoint theo dõi khóa này, như tác giả\n"}
,{"stream_name":"stdout","time":123.722274405,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":123.722277928,"data":"            self.log(f\"epoch_val_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":123.722281458,"data":"        return val_like\n"}
,{"stream_name":"stdout","time":123.722284957,"data":"\n"}
,{"stream_name":"stdout","time":123.722288218,"data":"    def test_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":123.722291587,"data":"        _, _, _, values = self._step(batch, \"test\")\n"}
,{"stream_name":"stdout","time":123.722295292,"data":"        return [values[\"accuracy_test_c_overall_post\"].item(), values[\"accuracy_test_c_post\"].item(),\n"}
,{"stream_name":"stdout","time":123.72229899,"data":"                values[\"accuracy_test_y_xy\"].item(), values[\"accuracy_test_y_post\"].item()]\n"}
,{"stream_name":"stdout","time":123.722302642,"data":"\n"}
,{"stream_name":"stdout","time":123.722305835,"data":"    def test_epoch_end(self, outputs):\n"}
,{"stream_name":"stdout","time":123.722309176,"data":"        mean = torch.tensor(outputs).mean(0)\n"}
,{"stream_name":"stdout","time":123.722312698,"data":"        for name, value in zip((\"accuracy_test_c_overall_post\", \"accuracy_test_c_post\", \"accuracy_test_y_xy\",\n"}
,{"stream_name":"stdout","time":123.722316557,"data":"                                \"accuracy_test_y_post\"), mean):\n"}
,{"stream_name":"stdout","time":123.722319999,"data":"            logging.info(\"%s: %s\", name, float(value))\n"}
,{"stream_name":"stdout","time":123.722323453,"data":"\n"}
