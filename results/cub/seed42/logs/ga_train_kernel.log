,{"stream_name":"stdout","time":165.361513042,"data":"# ===== ga_ecbm.py (file mới) =====\n"}
,{"stream_name":"stdout","time":165.361516225,"data":"\"\"\"GA-ECBM (Gated Additive ECBM) đặt trong code ECBM gốc (xmed-lab/ECBM, commit d38c43a).\n"}
,{"stream_name":"stdout","time":165.361519898,"data":"\n"}
,{"stream_name":"stdout","time":165.361523071,"data":"Giữ nguyên của tác giả: backbone ResNet101, nhánh ảnh → nhãn E_class và nhánh ảnh → concept E_concept của EBM_GL.\n"}
,{"stream_name":"stdout","time":165.361527313,"data":"Thay: E_global(c, y) = −(b_y + Σ_k θ_{y,k}·c_k), tức bảng điểm cộng tính thay cho MLP trên cả vector concept.\n"}
,{"stream_name":"stdout","time":165.361532024,"data":"Nhờ cộng tính, p(y | x, concept đã biết) và p(c_k | x, …) tính chính xác bằng công thức đóng, không cần tối ưu gradient.\n"}
,{"stream_name":"stdout","time":165.36153692,"data":"Khi can thiệp k nhóm concept, nhánh ảnh nhân với cổng w(k) = exp(−Σ_{j≤k} softplus(a_j)), w(0) = 1.\n"}
,{"stream_name":"stdout","time":165.361541468,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":165.361787065,"data":"import os\n"}
,{"stream_name":"stdout","time":165.361814247,"data":"\n"}
,{"stream_name":"stdout","time":165.36184603,"data":"import torch\n"}
,{"stream_name":"stdout","time":165.36186113,"data":"import torch.nn as nn\n"}
,{"stream_name":"stdout","time":165.361874358,"data":"import torch.nn.functional as F\n"}
,{"stream_name":"stdout","time":165.361889785,"data":"\n"}
,{"stream_name":"stdout","time":165.361906531,"data":"from data.cub import CONCEPT_GROUP_MAP\n"}
,{"stream_name":"stdout","time":165.361930579,"data":"from networks.EBM import ECBM\n"}
,{"stream_name":"stdout","time":165.361936128,"data":"\n"}
,{"stream_name":"stdout","time":165.361938641,"data":"GROUPS = [list(indices) for indices in CONCEPT_GROUP_MAP.values()]   # 28 nhóm, như phần can thiệp theo nhóm của tác giả\n"}
,{"stream_name":"stdout","time":165.361941531,"data":"GATE_INIT = float(os.environ.get(\"GA_GATE_INIT\", \"-3.1\"))             # softplus(−3.1) ≈ 0.044 → w(28) ≈ 0.29\n"}
,{"stream_name":"stdout","time":165.361944407,"data":"\n"}
,{"stream_name":"stdout","time":165.361946628,"data":"\n"}
,{"stream_name":"stdout","time":165.361948716,"data":"class GAECBM(ECBM):\n"}
,{"stream_name":"stdout","time":165.361951021,"data":"    def __init__(self, args, emb_size, cpt_size, hid_size, n_classes):\n"}
,{"stream_name":"stdout","time":165.361953298,"data":"        super().__init__(args, emb_size=emb_size, cpt_size=cpt_size, hid_size=hid_size, n_classes=n_classes)\n"}
,{"stream_name":"stdout","time":165.361991583,"data":"        head = self.energy_model\n"}
,{"stream_name":"stdout","time":165.362027167,"data":"        del head.concept_proj, head.fc_c, head.classifier_cy        # MLP E_global của tác giả: không dùng nữa\n"}
,{"stream_name":"stdout","time":165.362046561,"data":"        self.theta = nn.Parameter(torch.zeros(n_classes, cpt_size))  # θ_{y,k}: điểm của concept k = 1 cho loài y\n"}
,{"stream_name":"stdout","time":165.362064704,"data":"        self.label_bias = nn.Parameter(torch.zeros(n_classes))       # b_y\n"}
,{"stream_name":"stdout","time":165.362103198,"data":"        self.gate_steps = nn.Parameter(torch.full((len(GROUPS),), GATE_INIT))\n"}
,{"stream_name":"stdout","time":165.36213112,"data":"        group_of = torch.zeros(cpt_size, dtype=torch.long)\n"}
,{"stream_name":"stdout","time":165.362161284,"data":"        for g, indices in enumerate(GROUPS):\n"}
,{"stream_name":"stdout","time":165.362180579,"data":"            group_of[indices] = g\n"}
,{"stream_name":"stdout","time":165.362198535,"data":"        self.register_buffer(\"group_of\", group_of, persistent=False)\n"}
,{"stream_name":"stdout","time":165.362215416,"data":"\n"}
,{"stream_name":"stdout","time":165.362233519,"data":"    def energies(self, images):\n"}
,{"stream_name":"stdout","time":165.362250222,"data":"        \"\"\"E_class [B, C] và E_concept [B, K, 2] của tác giả; E_concept[..., s] là năng lượng của trạng thái s.\"\"\"\n"}
,{"stream_name":"stdout","time":165.362267561,"data":"        emb = self.backbone(images)\n"}
,{"stream_name":"stdout","time":165.362289304,"data":"        e_class, _, e_concept = self.energy_model(emb, None, True, use_cy=False)\n"}
,{"stream_name":"stdout","time":165.362311482,"data":"        return e_class, e_concept\n"}
,{"stream_name":"stdout","time":165.362393995,"data":"\n"}
,{"stream_name":"stdout","time":165.362431859,"data":"    def gate(self, verified_groups):\n"}
,{"stream_name":"stdout","time":165.362437623,"data":"        w = torch.exp(-torch.cat([self.gate_steps.new_zeros(1), torch.cumsum(F.softplus(self.gate_steps), 0)]))\n"}
,{"stream_name":"stdout","time":165.362441937,"data":"        return w[verified_groups]\n"}
,{"stream_name":"stdout","time":165.362445882,"data":"\n"}
,{"stream_name":"stdout","time":165.36244947,"data":"    def global_score(self, concepts):\n"}
,{"stream_name":"stdout","time":165.362453497,"data":"        \"\"\"−E_global(c, y) cho mọi y: [B, C].\"\"\"\n"}
,{"stream_name":"stdout","time":165.362457817,"data":"        return self.label_bias + concepts.float() @ self.theta.t()\n"}
,{"stream_name":"stdout","time":165.362461096,"data":"\n"}
,{"stream_name":"stdout","time":165.362464249,"data":"    def posterior(self, e_class, e_concept, mask=None, values=None, class_weight=None):\n"}
,{"stream_name":"stdout","time":165.36246822,"data":"        \"\"\"log p(y | x, c_S) [B, C] và p(c_k = 1 | x, c_S) [B, K]; tính ở FP32.\"\"\"\n"}
,{"stream_name":"stdout","time":165.362472414,"data":"        e_class, e_concept = e_class.float(), e_concept.float()\n"}
,{"stream_name":"stdout","time":165.362476463,"data":"        t1 = -e_concept[..., 1][:, None, :] + self.theta[None]          # [B, C, K]\n"}
,{"stream_name":"stdout","time":165.362480474,"data":"        t0 = (-e_concept[..., 0])[:, None, :].expand_as(t1)\n"}
,{"stream_name":"stdout","time":165.362484382,"data":"        per_concept = torch.logaddexp(t0, t1)\n"}
,{"stream_name":"stdout","time":165.362488717,"data":"        p1_given_y = torch.sigmoid(t1 - t0)\n"}
,{"stream_name":"stdout","time":165.36249278,"data":"        if mask is not None:\n"}
,{"stream_name":"stdout","time":165.362496462,"data":"            observed = torch.where(values[:, None, :].bool(), t1, t0)\n"}
,{"stream_name":"stdout","time":165.362500231,"data":"            per_concept = torch.where(mask[:, None, :], observed, per_concept)\n"}
,{"stream_name":"stdout","time":165.362503955,"data":"            p1_given_y = torch.where(mask[:, None, :], values[:, None, :].float(), p1_given_y)\n"}
,{"stream_name":"stdout","time":165.362507895,"data":"        weight = 1.0 if class_weight is None else class_weight.float()[:, None]\n"}
,{"stream_name":"stdout","time":165.362511684,"data":"        log_p_y = (-weight * e_class + self.label_bias[None] + per_concept.sum(-1)).log_softmax(-1)\n"}
,{"stream_name":"stdout","time":165.362515645,"data":"        return log_p_y, (log_p_y.exp()[:, :, None] * p1_given_y).sum(1)\n"}
,{"stream_name":"stdout","time":165.362528326,"data":"\n"}
,{"stream_name":"stdout","time":165.362532314,"data":"\n"}
,{"stream_name":"stdout","time":165.362537889,"data":"def ga_losses(model, loss_label, loss_concept, images, labels, concepts, weights=(3, 1, 1)):\n"}
,{"stream_name":"stdout","time":165.362541345,"data":"    \"\"\"Loss của GA-ECBM cho một batch.\n"}
,{"stream_name":"stdout","time":165.36254518,"data":"\n"}
,{"stream_name":"stdout","time":165.362548862,"data":"    Trả về (loss train, loss validation kiểu tác giả, các thành phần, (e_class, e_concept, concept sạch)).\n"}
,{"stream_name":"stdout","time":165.362553305,"data":"    Loss gốc 3 : 1 : 1 gọi đúng hàm loss và cy_augment của tác giả. Trong forward gốc, cy_augment sửa thẳng tensor concept\n"}
,{"stream_name":"stdout","time":165.362557385,"data":"    của batch, nên L_xc của tác giả cũng tính trên concept đã xáo trộn; ở đây giữ nguyên hành vi đó cho phần loss gốc.\n"}
,{"stream_name":"stdout","time":165.362562151,"data":"    Ba loss mới dùng concept sạch (bản sao lấy trước khi xáo trộn).\n"}
,{"stream_name":"stdout","time":165.362566385,"data":"    \"\"\"\n"}
,{"stream_name":"stdout","time":165.362570165,"data":"    clean = concepts.clone()\n"}
,{"stream_name":"stdout","time":165.362574062,"data":"    head = model.energy_model\n"}
,{"stream_name":"stdout","time":165.362577803,"data":"    e_class, e_concept = model.energies(images)\n"}
,{"stream_name":"stdout","time":165.3625814,"data":"    perturbed = head.cy_augment(c_gt=concepts.unsqueeze(-1), permute_ratio=head.cy_concept_perturb_prob,\n"}
,{"stream_name":"stdout","time":165.362584867,"data":"                                permute_prob=head.cy_sample_perturb_prob).squeeze(-1)\n"}
,{"stream_name":"stdout","time":165.362588227,"data":"    loss_xy = loss_label(e_class, labels)\n"}
,{"stream_name":"stdout","time":165.362591512,"data":"    loss_cy = loss_label(-model.global_score(perturbed), labels)       # EBMLoss_label nhận năng lượng\n"}
,{"stream_name":"stdout","time":165.362595077,"data":"    loss_xc = loss_concept(e_concept, concepts)\n"}
,{"stream_name":"stdout","time":165.362598324,"data":"    w_xy, w_xc, w_cy = weights\n"}
,{"stream_name":"stdout","time":165.362601505,"data":"    base = w_xy * loss_xy + w_xc * loss_xc + w_cy * loss_cy\n"}
,{"stream_name":"stdout","time":165.362604785,"data":"\n"}
,{"stream_name":"stdout","time":165.362607722,"data":"    device_type = \"cuda\" if images.is_cuda else \"cpu\"\n"}
,{"stream_name":"stdout","time":165.362611267,"data":"    with torch.autocast(device_type=device_type, enabled=False):\n"}
,{"stream_name":"stdout","time":165.362614559,"data":"        count, n_groups = len(labels), len(GROUPS)\n"}
,{"stream_name":"stdout","time":165.362617838,"data":"        log_p_y, p_c = model.posterior(e_class, e_concept)\n"}
,{"stream_name":"stdout","time":165.362621109,"data":"        joint = F.nll_loss(log_p_y, labels) + F.binary_cross_entropy(p_c.clamp(1e-6, 1 - 1e-6), clean.float())\n"}
,{"stream_name":"stdout","time":165.362624654,"data":"        groups = torch.rand(count, n_groups, device=images.device) \u003c torch.rand(count, 1, device=images.device)\n"}
,{"stream_name":"stdout","time":165.362628605,"data":"        drop = torch.rand(count, device=images.device) \u003c 0.5                  # nửa số ca tắt hẳn nhánh ảnh\n"}
,{"stream_name":"stdout","time":165.362633284,"data":"        k = groups.sum(1)\n"}
,{"stream_name":"stdout","time":165.362637257,"data":"        w_k = torch.where(drop, torch.zeros_like(k, dtype=torch.float), model.gate(k))\n"}
,{"stream_name":"stdout","time":165.362646117,"data":"        log_int, _ = model.posterior(e_class, e_concept, groups[:, model.group_of], clean, w_k)\n"}
,{"stream_name":"stdout","time":165.36265019,"data":"        loss_int = F.nll_loss(log_int, labels, reduction=\"none\")\n"}
,{"stream_name":"stdout","time":165.362654298,"data":"        extra = torch.multinomial((~groups).float() + 1e-9, 1).squeeze(1)      # xác minh thêm 1 nhóm\n"}
,{"stream_name":"stdout","time":165.362657955,"data":"        groups_more = groups.clone()\n"}
,{"stream_name":"stdout","time":165.362661258,"data":"        groups_more[torch.arange(count, device=images.device), extra] = True\n"}
,{"stream_name":"stdout","time":165.362664577,"data":"        k_more = groups_more.sum(1)\n"}
,{"stream_name":"stdout","time":165.362667803,"data":"        w_more = torch.where(drop, torch.zeros_like(k_more, dtype=torch.float), model.gate(k_more))\n"}
,{"stream_name":"stdout","time":165.362671141,"data":"        log_more, _ = model.posterior(e_class, e_concept, groups_more[:, model.group_of], clean, w_more)\n"}
,{"stream_name":"stdout","time":165.362674478,"data":"        mono = F.relu(F.nll_loss(log_more, labels, reduction=\"none\") - loss_int).mean()\n"}
,{"stream_name":"stdout","time":165.362677976,"data":"    total = base + joint + loss_int.mean() + mono\n"}
,{"stream_name":"stdout","time":165.362681278,"data":"    val_like = loss_xc + loss_xy + loss_cy                                   # như validation_step của tác giả\n"}
,{"stream_name":"stdout","time":165.362684761,"data":"    parts = {\"xy\": loss_xy, \"xc\": loss_xc, \"cy\": loss_cy, \"joint\": joint, \"int\": loss_int.mean(), \"mono\": mono}\n"}
,{"stream_name":"stdout","time":165.362688746,"data":"    return total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c)\n"}
,{"stream_name":"stdout","time":165.362692048,"data":"\n"}
,{"stream_name":"stdout","time":165.362695123,"data":"# ===== ga_litmodel.py (file mới) =====\n"}
,{"stream_name":"stdout","time":165.362698351,"data":"\"\"\"LightningModule của GA-ECBM: kế thừa LitModel của tác giả, giữ nguyên optimizer, scheduler và cách log.\n"}
,{"stream_name":"stdout","time":165.362702208,"data":"\n"}
,{"stream_name":"stdout","time":165.36270532,"data":"main.py chỉ đổi một dòng import để dùng lớp này; mọi thứ khác (dữ liệu, sampler, ModelCheckpoint, số epoch) giữ nguyên.\n"}
,{"stream_name":"stdout","time":165.362710993,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":165.362731965,"data":"import logging\n"}
,{"stream_name":"stdout","time":165.362735831,"data":"import os\n"}
,{"stream_name":"stdout","time":165.3627395,"data":"\n"}
,{"stream_name":"stdout","time":165.36274314,"data":"import torch\n"}
,{"stream_name":"stdout","time":165.36274679,"data":"\n"}
,{"stream_name":"stdout","time":165.362749923,"data":"from LitModel import LitModel\n"}
,{"stream_name":"stdout","time":165.362753099,"data":"from ga_ecbm import GATE_INIT, GROUPS, GAECBM, ga_losses\n"}
,{"stream_name":"stdout","time":165.362756368,"data":"\n"}
,{"stream_name":"stdout","time":165.362759395,"data":"\n"}
,{"stream_name":"stdout","time":165.36276238599999,"data":"def _accuracy(pred, target):\n"}
,{"stream_name":"stdout","time":165.362765612,"data":"    return (pred == target).float().mean()\n"}
,{"stream_name":"stdout","time":165.362768739,"data":"\n"}
,{"stream_name":"stdout","time":165.362771731,"data":"\n"}
,{"stream_name":"stdout","time":165.362774733,"data":"class GALitModel(LitModel):\n"}
,{"stream_name":"stdout","time":165.362777918,"data":"    def __init__(self, logdir, args):\n"}
,{"stream_name":"stdout","time":165.362784761,"data":"        super().__init__(logdir, args)\n"}
,{"stream_name":"stdout","time":165.362788099,"data":"        self.network = GAECBM(args=args, emb_size=args.emb_size, cpt_size=args.cpt_size, hid_size=args.hid_size,\n"}
,{"stream_name":"stdout","time":165.362791501,"data":"                              n_classes=args.n_classes)\n"}
,{"stream_name":"stdout","time":165.36279476,"data":"        logging.info(\"GA-ECBM: gate_init=%s, groups=%d\", GATE_INIT, len(GROUPS))   # dấu để notebook nhận ra lần chạy GA\n"}
,{"stream_name":"stdout","time":165.362798488,"data":"\n"}
,{"stream_name":"stdout","time":165.362803173,"data":"    def _step(self, batch, stage):\n"}
,{"stream_name":"stdout","time":165.36281004,"data":"        images, labels, concepts = batch\n"}
,{"stream_name":"stdout","time":165.362813263,"data":"        total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c) = ga_losses(\n"}
,{"stream_name":"stdout","time":165.362828025,"data":"            self.network, self.loss_label, self.loss_concept, images, labels, concepts,\n"}
,{"stream_name":"stdout","time":165.362832071,"data":"            (self.lambda_xy, self.lambda_xc, self.lambda_cy))\n"}
,{"stream_name":"stdout","time":165.362835827,"data":"        pred_c_direct = torch.argmin(e_concept, 2)\n"}
,{"stream_name":"stdout","time":165.362839565,"data":"        pred_c_post = (p_c \u003e 0.5).long()\n"}
,{"stream_name":"stdout","time":165.36284358,"data":"        values = {\n"}
,{"stream_name":"stdout","time":165.362846919,"data":"            # như tác giả: đọc trực tiếp năng lượng, concept so với tensor của batch (đã bị cy_augment sửa)\n"}
,{"stream_name":"stdout","time":165.362850795,"data":"            f\"accuracy_{stage}_y_xy\": _accuracy(torch.argmin(e_class, 1), labels),\n"}
,{"stream_name":"stdout","time":165.362854235,"data":"            f\"accuracy_{stage}_c\": _accuracy(pred_c_direct, concepts),\n"}
,{"stream_name":"stdout","time":165.362857598,"data":"            f\"accuracy_{stage}_c_overall\": (pred_c_direct == concepts).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":165.362860965,"data":"            # GA-ECBM: suy luận chính xác, so với concept sạch\n"}
,{"stream_name":"stdout","time":165.36286446,"data":"            f\"accuracy_{stage}_y_post\": _accuracy(log_p_y.argmax(1), labels),\n"}
,{"stream_name":"stdout","time":165.362867838,"data":"            f\"accuracy_{stage}_c_post\": _accuracy(pred_c_post, clean),\n"}
,{"stream_name":"stdout","time":165.362871253,"data":"            f\"accuracy_{stage}_c_overall_post\": (pred_c_post == clean).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":165.362874708,"data":"        }\n"}
,{"stream_name":"stdout","time":165.362877907,"data":"        for name, value in values.items():\n"}
,{"stream_name":"stdout","time":165.362881157,"data":"            self.log(name, value, on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":165.362884498,"data":"        return total, val_like, parts, values\n"}
,{"stream_name":"stdout","time":165.36288769,"data":"\n"}
,{"stream_name":"stdout","time":165.362890745,"data":"    def training_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":165.36289413,"data":"        total, _, parts, _ = self._step(batch, \"train\")\n"}
,{"stream_name":"stdout","time":165.36289764,"data":"        self.log(\"epoch_loss\", total, on_epoch=True)                 # scheduler của tác giả theo dõi epoch_loss_epoch\n"}
,{"stream_name":"stdout","time":165.362923566,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":165.362927646,"data":"            self.log(f\"epoch_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":165.362941783,"data":"        if batch_idx == 0:\n"}
,{"stream_name":"stdout","time":165.362945357,"data":"            w = self.network.gate(torch.tensor([0, 7, 14, 28], device=self.device))\n"}
,{"stream_name":"stdout","time":165.362948679,"data":"            self.log(\"gate_w_7\", w[1], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":165.362952026,"data":"            self.log(\"gate_w_28\", w[3], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":165.362955445,"data":"        return total\n"}
,{"stream_name":"stdout","time":165.36295863,"data":"\n"}
,{"stream_name":"stdout","time":165.362961716,"data":"    def validation_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":165.362964958,"data":"        _, val_like, parts, _ = self._step(batch, \"val\")\n"}
,{"stream_name":"stdout","time":165.362968315,"data":"        self.log(\"epoch_val_loss\", val_like, on_epoch=True)         # ModelCheckpoint theo dõi khóa này, như tác giả\n"}
,{"stream_name":"stdout","time":165.362971967,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":165.36297515,"data":"            self.log(f\"epoch_val_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":165.362978546,"data":"        return val_like\n"}
,{"stream_name":"stdout","time":165.362981743,"data":"\n"}
,{"stream_name":"stdout","time":165.362985522,"data":"    def test_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":165.362988765,"data":"        _, _, _, values = self._step(batch, \"test\")\n"}
,{"stream_name":"stdout","time":165.362993898,"data":"        return [values[\"accuracy_test_c_overall_post\"].item(), values[\"accuracy_test_c_post\"].item(),\n"}
,{"stream_name":"stdout","time":165.363000976,"data":"                values[\"accuracy_test_y_xy\"].item(), values[\"accuracy_test_y_post\"].item()]\n"}
,{"stream_name":"stdout","time":165.363014418,"data":"\n"}
,{"stream_name":"stdout","time":165.363018061,"data":"    def test_epoch_end(self, outputs):\n"}
,{"stream_name":"stdout","time":165.363021834,"data":"        mean = torch.tensor(outputs).mean(0)\n"}
,{"stream_name":"stdout","time":165.363025822,"data":"        for name, value in zip((\"accuracy_test_c_overall_post\", \"accuracy_test_c_post\", \"accuracy_test_y_xy\",\n"}
,{"stream_name":"stdout","time":165.363030078,"data":"                                \"accuracy_test_y_post\"), mean):\n"}
,{"stream_name":"stdout","time":165.363033986,"data":"            logging.info(\"%s: %s\", name, float(value))\n"}
,{"stream_name":"stdout","time":165.363038166,"data":"\n"}
,{"stream_name":"stdout","time":166.773094005,"data":"Sai lệch lớn nhất so với duyệt hết tổ hợp: 5.96e-07\n"}
