,{"stream_name":"stdout","time":145.846307036,"data":"# ===== ga_ecbm.py (file mới) =====\n"}
,{"stream_name":"stdout","time":145.846312023,"data":"\"\"\"GA-ECBM (Gated Additive ECBM) đặt trong code ECBM gốc (xmed-lab/ECBM, commit d38c43a).\n"}
,{"stream_name":"stdout","time":145.846316355,"data":"\n"}
,{"stream_name":"stdout","time":145.846320129,"data":"Giữ nguyên của tác giả: backbone ResNet101, nhánh ảnh → nhãn E_class và nhánh ảnh → concept E_concept của EBM_GL.\n"}
,{"stream_name":"stdout","time":145.84632478,"data":"Thay: E_global(c, y) = −(b_y + Σ_k θ_{y,k}·c_k), tức bảng điểm cộng tính thay cho MLP trên cả vector concept.\n"}
,{"stream_name":"stdout","time":145.846329544,"data":"Nhờ cộng tính, p(y | x, concept đã biết) và p(c_k | x, …) tính chính xác bằng công thức đóng, không cần tối ưu gradient.\n"}
,{"stream_name":"stdout","time":145.846334108,"data":"Khi can thiệp k nhóm concept, nhánh ảnh nhân với cổng w(k) = exp(−Σ_{j≤k} softplus(a_j)), w(0) = 1.\n"}
,{"stream_name":"stdout","time":145.846338832,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":145.846342888,"data":"import os\n"}
,{"stream_name":"stdout","time":145.846346979,"data":"\n"}
,{"stream_name":"stdout","time":145.846350403,"data":"import torch\n"}
,{"stream_name":"stdout","time":145.846353971,"data":"import torch.nn as nn\n"}
,{"stream_name":"stdout","time":145.846357884,"data":"import torch.nn.functional as F\n"}
,{"stream_name":"stdout","time":145.84636149,"data":"\n"}
,{"stream_name":"stdout","time":145.846364887,"data":"from data.cub import CONCEPT_GROUP_MAP\n"}
,{"stream_name":"stdout","time":145.846368676,"data":"from networks.EBM import ECBM\n"}
,{"stream_name":"stdout","time":145.846372588,"data":"\n"}
,{"stream_name":"stdout","time":145.846376345,"data":"GROUPS = [list(indices) for indices in CONCEPT_GROUP_MAP.values()]   # 28 nhóm, như phần can thiệp theo nhóm của tác giả\n"}
,{"stream_name":"stdout","time":145.846380905,"data":"GATE_INIT = float(os.environ.get(\"GA_GATE_INIT\", \"-3.1\"))             # softplus(−3.1) ≈ 0.044 → w(28) ≈ 0.29\n"}
,{"stream_name":"stdout","time":145.846385566,"data":"\n"}
,{"stream_name":"stdout","time":145.846389344,"data":"\n"}
,{"stream_name":"stdout","time":145.846393209,"data":"class GAECBM(ECBM):\n"}
,{"stream_name":"stdout","time":145.846397219,"data":"    def __init__(self, args, emb_size, cpt_size, hid_size, n_classes):\n"}
,{"stream_name":"stdout","time":145.84640149,"data":"        super().__init__(args, emb_size=emb_size, cpt_size=cpt_size, hid_size=hid_size, n_classes=n_classes)\n"}
,{"stream_name":"stdout","time":145.846405936,"data":"        head = self.energy_model\n"}
,{"stream_name":"stdout","time":145.846410104,"data":"        del head.concept_proj, head.fc_c, head.classifier_cy        # MLP E_global của tác giả: không dùng nữa\n"}
,{"stream_name":"stdout","time":145.846414688,"data":"        self.theta = nn.Parameter(torch.zeros(n_classes, cpt_size))  # θ_{y,k}: điểm của concept k = 1 cho loài y\n"}
,{"stream_name":"stdout","time":145.846419728,"data":"        self.label_bias = nn.Parameter(torch.zeros(n_classes))       # b_y\n"}
,{"stream_name":"stdout","time":145.846423941,"data":"        self.gate_steps = nn.Parameter(torch.full((len(GROUPS),), GATE_INIT))\n"}
,{"stream_name":"stdout","time":145.846433323,"data":"        group_of = torch.zeros(cpt_size, dtype=torch.long)\n"}
,{"stream_name":"stdout","time":145.846438353,"data":"        for g, indices in enumerate(GROUPS):\n"}
,{"stream_name":"stdout","time":145.846441958,"data":"            group_of[indices] = g\n"}
,{"stream_name":"stdout","time":145.846445661,"data":"        self.register_buffer(\"group_of\", group_of, persistent=False)\n"}
,{"stream_name":"stdout","time":145.846449859,"data":"\n"}
,{"stream_name":"stdout","time":145.846453557,"data":"    def energies(self, images):\n"}
,{"stream_name":"stdout","time":145.846457525,"data":"        \"\"\"E_class [B, C] và E_concept [B, K, 2] của tác giả; E_concept[..., s] là năng lượng của trạng thái s.\"\"\"\n"}
,{"stream_name":"stdout","time":145.846462359,"data":"        emb = self.backbone(images)\n"}
,{"stream_name":"stdout","time":145.84646626400001,"data":"        e_class, _, e_concept = self.energy_model(emb, None, True, use_cy=False)\n"}
,{"stream_name":"stdout","time":145.846470326,"data":"        return e_class, e_concept\n"}
,{"stream_name":"stdout","time":145.846474215,"data":"\n"}
,{"stream_name":"stdout","time":145.846477958,"data":"    def gate(self, verified_groups):\n"}
,{"stream_name":"stdout","time":145.846481944,"data":"        w = torch.exp(-torch.cat([self.gate_steps.new_zeros(1), torch.cumsum(F.softplus(self.gate_steps), 0)]))\n"}
,{"stream_name":"stdout","time":145.846485897,"data":"        return w[verified_groups]\n"}
,{"stream_name":"stdout","time":145.846489528,"data":"\n"}
,{"stream_name":"stdout","time":145.846493092,"data":"    def global_score(self, concepts):\n"}
,{"stream_name":"stdout","time":145.846497056,"data":"        \"\"\"−E_global(c, y) cho mọi y: [B, C].\"\"\"\n"}
,{"stream_name":"stdout","time":145.846501514,"data":"        return self.label_bias + concepts.float() @ self.theta.t()\n"}
,{"stream_name":"stdout","time":145.846505272,"data":"\n"}
,{"stream_name":"stdout","time":145.846508905,"data":"    def posterior(self, e_class, e_concept, mask=None, values=None, class_weight=None):\n"}
,{"stream_name":"stdout","time":145.846512952,"data":"        \"\"\"log p(y | x, c_S) [B, C] và p(c_k = 1 | x, c_S) [B, K]; tính ở FP32.\"\"\"\n"}
,{"stream_name":"stdout","time":145.846517201,"data":"        e_class, e_concept = e_class.float(), e_concept.float()\n"}
,{"stream_name":"stdout","time":145.846520948,"data":"        t1 = -e_concept[..., 1][:, None, :] + self.theta[None]          # [B, C, K]\n"}
,{"stream_name":"stdout","time":145.846525146,"data":"        t0 = (-e_concept[..., 0])[:, None, :].expand_as(t1)\n"}
,{"stream_name":"stdout","time":145.846529391,"data":"        per_concept = torch.logaddexp(t0, t1)\n"}
,{"stream_name":"stdout","time":145.846533259,"data":"        p1_given_y = torch.sigmoid(t1 - t0)\n"}
,{"stream_name":"stdout","time":145.84653702,"data":"        if mask is not None:\n"}
,{"stream_name":"stdout","time":145.846540711,"data":"            observed = torch.where(values[:, None, :].bool(), t1, t0)\n"}
,{"stream_name":"stdout","time":145.846544476,"data":"            per_concept = torch.where(mask[:, None, :], observed, per_concept)\n"}
,{"stream_name":"stdout","time":145.846548448,"data":"            p1_given_y = torch.where(mask[:, None, :], values[:, None, :].float(), p1_given_y)\n"}
,{"stream_name":"stdout","time":145.846552577,"data":"        weight = 1.0 if class_weight is None else class_weight.float()[:, None]\n"}
,{"stream_name":"stdout","time":145.846556764,"data":"        log_p_y = (-weight * e_class + self.label_bias[None] + per_concept.sum(-1)).log_softmax(-1)\n"}
,{"stream_name":"stdout","time":145.846560956,"data":"        return log_p_y, (log_p_y.exp()[:, :, None] * p1_given_y).sum(1)\n"}
,{"stream_name":"stdout","time":145.846569269,"data":"\n"}
,{"stream_name":"stdout","time":145.846573039,"data":"\n"}
,{"stream_name":"stdout","time":145.846576915,"data":"def ga_losses(model, loss_label, loss_concept, images, labels, concepts, weights=(3, 1, 1)):\n"}
,{"stream_name":"stdout","time":145.846581339,"data":"    \"\"\"Loss của GA-ECBM cho một batch.\n"}
,{"stream_name":"stdout","time":145.846585689,"data":"\n"}
,{"stream_name":"stdout","time":145.846589466,"data":"    Trả về (loss train, loss validation kiểu tác giả, các thành phần, (e_class, e_concept, concept sạch)).\n"}
,{"stream_name":"stdout","time":145.846595183,"data":"    Loss gốc 3 : 1 : 1 gọi đúng hàm loss và cy_augment của tác giả. Trong forward gốc, cy_augment sửa thẳng tensor concept\n"}
,{"stream_name":"stdout","time":145.846599923,"data":"    của batch, nên L_xc của tác giả cũng tính trên concept đã xáo trộn; ở đây giữ nguyên hành vi đó cho phần loss gốc.\n"}
,{"stream_name":"stdout","time":145.846605075,"data":"    Ba loss mới dùng concept sạch (bản sao lấy trước khi xáo trộn).\n"}
,{"stream_name":"stdout","time":145.846609541,"data":"    \"\"\"\n"}
,{"stream_name":"stdout","time":145.846613553,"data":"    clean = concepts.clone()\n"}
,{"stream_name":"stdout","time":145.8466176,"data":"    head = model.energy_model\n"}
,{"stream_name":"stdout","time":145.846621672,"data":"    e_class, e_concept = model.energies(images)\n"}
,{"stream_name":"stdout","time":145.846625828,"data":"    perturbed = head.cy_augment(c_gt=concepts.unsqueeze(-1), permute_ratio=head.cy_concept_perturb_prob,\n"}
,{"stream_name":"stdout","time":145.846630161,"data":"                                permute_prob=head.cy_sample_perturb_prob).squeeze(-1)\n"}
,{"stream_name":"stdout","time":145.846634392,"data":"    loss_xy = loss_label(e_class, labels)\n"}
,{"stream_name":"stdout","time":145.846638445,"data":"    loss_cy = loss_label(-model.global_score(perturbed), labels)       # EBMLoss_label nhận năng lượng\n"}
,{"stream_name":"stdout","time":145.846642969,"data":"    loss_xc = loss_concept(e_concept, concepts)\n"}
,{"stream_name":"stdout","time":145.846646998,"data":"    w_xy, w_xc, w_cy = weights\n"}
,{"stream_name":"stdout","time":145.846650861,"data":"    base = w_xy * loss_xy + w_xc * loss_xc + w_cy * loss_cy\n"}
,{"stream_name":"stdout","time":145.846655032,"data":"\n"}
,{"stream_name":"stdout","time":145.846658829,"data":"    device_type = \"cuda\" if images.is_cuda else \"cpu\"\n"}
,{"stream_name":"stdout","time":145.846663187,"data":"    with torch.autocast(device_type=device_type, enabled=False):\n"}
,{"stream_name":"stdout","time":145.846667281,"data":"        count, n_groups = len(labels), len(GROUPS)\n"}
,{"stream_name":"stdout","time":145.846764755,"data":"        log_p_y, p_c = model.posterior(e_class, e_concept)\n"}
,{"stream_name":"stdout","time":145.846778061,"data":"        joint = F.nll_loss(log_p_y, labels) + F.binary_cross_entropy(p_c.clamp(1e-6, 1 - 1e-6), clean.float())\n"}
,{"stream_name":"stdout","time":145.846783064,"data":"        groups = torch.rand(count, n_groups, device=images.device) \u003c torch.rand(count, 1, device=images.device)\n"}
,{"stream_name":"stdout","time":145.846788023,"data":"        drop = torch.rand(count, device=images.device) \u003c 0.5                  # nửa số ca tắt hẳn nhánh ảnh\n"}
,{"stream_name":"stdout","time":145.846793018,"data":"        k = groups.sum(1)\n"}
,{"stream_name":"stdout","time":145.846797261,"data":"        w_k = torch.where(drop, torch.zeros_like(k, dtype=torch.float), model.gate(k))\n"}
,{"stream_name":"stdout","time":145.846808807,"data":"        log_int, _ = model.posterior(e_class, e_concept, groups[:, model.group_of], clean, w_k)\n"}
,{"stream_name":"stdout","time":145.846813768,"data":"        loss_int = F.nll_loss(log_int, labels, reduction=\"none\")\n"}
,{"stream_name":"stdout","time":145.846818507,"data":"        extra = torch.multinomial((~groups).float() + 1e-9, 1).squeeze(1)      # xác minh thêm 1 nhóm\n"}
,{"stream_name":"stdout","time":145.846823621,"data":"        groups_more = groups.clone()\n"}
,{"stream_name":"stdout","time":145.846827919,"data":"        groups_more[torch.arange(count, device=images.device), extra] = True\n"}
,{"stream_name":"stdout","time":145.846833977,"data":"        k_more = groups_more.sum(1)\n"}
,{"stream_name":"stdout","time":145.846838187,"data":"        w_more = torch.where(drop, torch.zeros_like(k_more, dtype=torch.float), model.gate(k_more))\n"}
,{"stream_name":"stdout","time":145.846842913,"data":"        log_more, _ = model.posterior(e_class, e_concept, groups_more[:, model.group_of], clean, w_more)\n"}
,{"stream_name":"stdout","time":145.846847437,"data":"        mono = F.relu(F.nll_loss(log_more, labels, reduction=\"none\") - loss_int).mean()\n"}
,{"stream_name":"stdout","time":145.846852429,"data":"    total = base + joint + loss_int.mean() + mono\n"}
,{"stream_name":"stdout","time":145.846856661,"data":"    val_like = loss_xc + loss_xy + loss_cy                                   # như validation_step của tác giả\n"}
,{"stream_name":"stdout","time":145.846861613,"data":"    parts = {\"xy\": loss_xy, \"xc\": loss_xc, \"cy\": loss_cy, \"joint\": joint, \"int\": loss_int.mean(), \"mono\": mono}\n"}
,{"stream_name":"stdout","time":145.8468666,"data":"    return total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c)\n"}
,{"stream_name":"stdout","time":145.846870986,"data":"\n"}
,{"stream_name":"stdout","time":145.846874987,"data":"# ===== ga_litmodel.py (file mới) =====\n"}
,{"stream_name":"stdout","time":145.846879206,"data":"\"\"\"LightningModule của GA-ECBM: kế thừa LitModel của tác giả, giữ nguyên optimizer, scheduler và cách log.\n"}
,{"stream_name":"stdout","time":145.84688449,"data":"\n"}
,{"stream_name":"stdout","time":145.846888265,"data":"main.py chỉ đổi một dòng import để dùng lớp này; mọi thứ khác (dữ liệu, sampler, ModelCheckpoint, số epoch) giữ nguyên.\n"}
,{"stream_name":"stdout","time":145.846893645,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":145.846897534,"data":"import logging\n"}
,{"stream_name":"stdout","time":145.84690145,"data":"import os\n"}
,{"stream_name":"stdout","time":145.846905521,"data":"\n"}
,{"stream_name":"stdout","time":145.846909509,"data":"import torch\n"}
,{"stream_name":"stdout","time":145.846913437,"data":"\n"}
,{"stream_name":"stdout","time":145.846917361,"data":"from LitModel import LitModel\n"}
,{"stream_name":"stdout","time":145.846921809,"data":"from ga_ecbm import GATE_INIT, GROUPS, GAECBM, ga_losses\n"}
,{"stream_name":"stdout","time":145.84692599,"data":"\n"}
,{"stream_name":"stdout","time":145.846929983,"data":"\n"}
,{"stream_name":"stdout","time":145.846934169,"data":"def _accuracy(pred, target):\n"}
,{"stream_name":"stdout","time":145.846938512,"data":"    return (pred == target).float().mean()\n"}
,{"stream_name":"stdout","time":145.846942848,"data":"\n"}
,{"stream_name":"stdout","time":145.846946902,"data":"\n"}
,{"stream_name":"stdout","time":145.846951209,"data":"class GALitModel(LitModel):\n"}
,{"stream_name":"stdout","time":145.846955806,"data":"    def __init__(self, logdir, args):\n"}
,{"stream_name":"stdout","time":145.846965894,"data":"        super().__init__(logdir, args)\n"}
,{"stream_name":"stdout","time":145.846971046,"data":"        self.network = GAECBM(args=args, emb_size=args.emb_size, cpt_size=args.cpt_size, hid_size=args.hid_size,\n"}
,{"stream_name":"stdout","time":145.846975364,"data":"                              n_classes=args.n_classes)\n"}
,{"stream_name":"stdout","time":145.846979606,"data":"        logging.info(\"GA-ECBM: gate_init=%s, groups=%d\", GATE_INIT, len(GROUPS))   # dấu để notebook nhận ra lần chạy GA\n"}
,{"stream_name":"stdout","time":145.846984766,"data":"\n"}
,{"stream_name":"stdout","time":145.846988863,"data":"    def _step(self, batch, stage):\n"}
,{"stream_name":"stdout","time":145.846993225,"data":"        images, labels, concepts = batch\n"}
,{"stream_name":"stdout","time":145.846997545,"data":"        total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c) = ga_losses(\n"}
,{"stream_name":"stdout","time":145.847002105,"data":"            self.network, self.loss_label, self.loss_concept, images, labels, concepts,\n"}
,{"stream_name":"stdout","time":145.847006561,"data":"            (self.lambda_xy, self.lambda_xc, self.lambda_cy))\n"}
,{"stream_name":"stdout","time":145.847010935,"data":"        pred_c_direct = torch.argmin(e_concept, 2)\n"}
,{"stream_name":"stdout","time":145.84701505499999,"data":"        pred_c_post = (p_c \u003e 0.5).long()\n"}
,{"stream_name":"stdout","time":145.847019575,"data":"        values = {\n"}
,{"stream_name":"stdout","time":145.847025097,"data":"            # như tác giả: đọc trực tiếp năng lượng, concept so với tensor của batch (đã bị cy_augment sửa)\n"}
,{"stream_name":"stdout","time":145.847031137,"data":"            f\"accuracy_{stage}_y_xy\": _accuracy(torch.argmin(e_class, 1), labels),\n"}
,{"stream_name":"stdout","time":145.847035968,"data":"            f\"accuracy_{stage}_c\": _accuracy(pred_c_direct, concepts),\n"}
,{"stream_name":"stdout","time":145.847040782,"data":"            f\"accuracy_{stage}_c_overall\": (pred_c_direct == concepts).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":145.84704646,"data":"            # GA-ECBM: suy luận chính xác, so với concept sạch\n"}
,{"stream_name":"stdout","time":145.847051282,"data":"            f\"accuracy_{stage}_y_post\": _accuracy(log_p_y.argmax(1), labels),\n"}
,{"stream_name":"stdout","time":145.847056123,"data":"            f\"accuracy_{stage}_c_post\": _accuracy(pred_c_post, clean),\n"}
,{"stream_name":"stdout","time":145.847060899,"data":"            f\"accuracy_{stage}_c_overall_post\": (pred_c_post == clean).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":145.847065875,"data":"        }\n"}
,{"stream_name":"stdout","time":145.847070117,"data":"        for name, value in values.items():\n"}
,{"stream_name":"stdout","time":145.847074139,"data":"            self.log(name, value, on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":145.847078403,"data":"        return total, val_like, parts, values\n"}
,{"stream_name":"stdout","time":145.847082884,"data":"\n"}
,{"stream_name":"stdout","time":145.847087001,"data":"    def training_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":145.847091445,"data":"        total, _, parts, _ = self._step(batch, \"train\")\n"}
,{"stream_name":"stdout","time":145.847096224,"data":"        self.log(\"epoch_loss\", total, on_epoch=True)                 # scheduler của tác giả theo dõi epoch_loss_epoch\n"}
,{"stream_name":"stdout","time":145.847101639,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":145.847106185,"data":"            self.log(f\"epoch_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":145.847115717,"data":"        if batch_idx == 0:\n"}
,{"stream_name":"stdout","time":145.84712016,"data":"            w = self.network.gate(torch.tensor([0, 7, 14, 28], device=self.device))\n"}
,{"stream_name":"stdout","time":145.847124784,"data":"            self.log(\"gate_w_7\", w[1], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":145.847129241,"data":"            self.log(\"gate_w_28\", w[3], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":145.847133893,"data":"        return total\n"}
,{"stream_name":"stdout","time":145.84713824,"data":"\n"}
,{"stream_name":"stdout","time":145.847142585,"data":"    def validation_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":145.847146939,"data":"        _, val_like, parts, _ = self._step(batch, \"val\")\n"}
,{"stream_name":"stdout","time":145.84715131,"data":"        self.log(\"epoch_val_loss\", val_like, on_epoch=True)         # ModelCheckpoint theo dõi khóa này, như tác giả\n"}
,{"stream_name":"stdout","time":145.847156525,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":145.847160877,"data":"            self.log(f\"epoch_val_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":145.84716556,"data":"        return val_like\n"}
,{"stream_name":"stdout","time":145.847169751,"data":"\n"}
,{"stream_name":"stdout","time":145.847173868,"data":"    def test_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":145.847178135,"data":"        _, _, _, values = self._step(batch, \"test\")\n"}
,{"stream_name":"stdout","time":145.84718277,"data":"        return [values[\"accuracy_test_c_overall_post\"].item(), values[\"accuracy_test_c_post\"].item(),\n"}
,{"stream_name":"stdout","time":145.847188887,"data":"                values[\"accuracy_test_y_xy\"].item(), values[\"accuracy_test_y_post\"].item()]\n"}
,{"stream_name":"stdout","time":145.84719417,"data":"\n"}
,{"stream_name":"stdout","time":145.847212112,"data":"    def test_epoch_end(self, outputs):\n"}
,{"stream_name":"stdout","time":145.847216581,"data":"        mean = torch.tensor(outputs).mean(0)\n"}
,{"stream_name":"stdout","time":145.847221129,"data":"        for name, value in zip((\"accuracy_test_c_overall_post\", \"accuracy_test_c_post\", \"accuracy_test_y_xy\",\n"}
,{"stream_name":"stdout","time":145.847226205,"data":"                                \"accuracy_test_y_post\"), mean):\n"}
,{"stream_name":"stdout","time":145.847230941,"data":"            logging.info(\"%s: %s\", name, float(value))\n"}
,{"stream_name":"stdout","time":145.847235641,"data":"\n"}
