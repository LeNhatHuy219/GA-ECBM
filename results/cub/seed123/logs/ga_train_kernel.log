,{"stream_name":"stdout","time":157.330306472,"data":"# ===== ga_ecbm.py (file mới) =====\n"}
,{"stream_name":"stdout","time":157.330309968,"data":"\"\"\"GA-ECBM (Gated Additive ECBM) đặt trong code ECBM gốc (xmed-lab/ECBM, commit d38c43a).\n"}
,{"stream_name":"stdout","time":157.330313522,"data":"\n"}
,{"stream_name":"stdout","time":157.330316675,"data":"Giữ nguyên của tác giả: backbone ResNet101, nhánh ảnh → nhãn E_class và nhánh ảnh → concept E_concept của EBM_GL.\n"}
,{"stream_name":"stdout","time":157.330320594,"data":"Thay: E_global(c, y) = −(b_y + Σ_k θ_{y,k}·c_k), tức bảng điểm cộng tính thay cho MLP trên cả vector concept.\n"}
,{"stream_name":"stdout","time":157.330324397,"data":"Nhờ cộng tính, p(y | x, concept đã biết) và p(c_k | x, …) tính chính xác bằng công thức đóng, không cần tối ưu gradient.\n"}
,{"stream_name":"stdout","time":157.330328422,"data":"Khi can thiệp k nhóm concept, nhánh ảnh nhân với cổng w(k) = exp(−Σ_{j≤k} softplus(a_j)), w(0) = 1.\n"}
,{"stream_name":"stdout","time":157.33033211,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":157.330335334,"data":"import os\n"}
,{"stream_name":"stdout","time":157.330338535,"data":"\n"}
,{"stream_name":"stdout","time":157.330341664,"data":"import torch\n"}
,{"stream_name":"stdout","time":157.330344831,"data":"import torch.nn as nn\n"}
,{"stream_name":"stdout","time":157.330348043,"data":"import torch.nn.functional as F\n"}
,{"stream_name":"stdout","time":157.330351246,"data":"\n"}
,{"stream_name":"stdout","time":157.330354383,"data":"from data.cub import CONCEPT_GROUP_MAP\n"}
,{"stream_name":"stdout","time":157.330357819,"data":"from networks.EBM import ECBM\n"}
,{"stream_name":"stdout","time":157.330360895,"data":"\n"}
,{"stream_name":"stdout","time":157.330365603,"data":"GROUPS = [list(indices) for indices in CONCEPT_GROUP_MAP.values()]   # 28 nhóm, như phần can thiệp theo nhóm của tác giả\n"}
,{"stream_name":"stdout","time":157.330373745,"data":"GATE_INIT = float(os.environ.get(\"GA_GATE_INIT\", \"-3.1\"))             # softplus(−3.1) ≈ 0.044 → w(28) ≈ 0.29\n"}
,{"stream_name":"stdout","time":157.330376675,"data":"\n"}
,{"stream_name":"stdout","time":157.330378732,"data":"\n"}
,{"stream_name":"stdout","time":157.33038078,"data":"class GAECBM(ECBM):\n"}
,{"stream_name":"stdout","time":157.330382929,"data":"    def __init__(self, args, emb_size, cpt_size, hid_size, n_classes):\n"}
,{"stream_name":"stdout","time":157.330385148,"data":"        super().__init__(args, emb_size=emb_size, cpt_size=cpt_size, hid_size=hid_size, n_classes=n_classes)\n"}
,{"stream_name":"stdout","time":157.330387444,"data":"        head = self.energy_model\n"}
,{"stream_name":"stdout","time":157.330390165,"data":"        del head.concept_proj, head.fc_c, head.classifier_cy        # MLP E_global của tác giả: không dùng nữa\n"}
,{"stream_name":"stdout","time":157.330392648,"data":"        self.theta = nn.Parameter(torch.zeros(n_classes, cpt_size))  # θ_{y,k}: điểm của concept k = 1 cho loài y\n"}
,{"stream_name":"stdout","time":157.330398398,"data":"        self.label_bias = nn.Parameter(torch.zeros(n_classes))       # b_y\n"}
,{"stream_name":"stdout","time":157.330400809,"data":"        self.gate_steps = nn.Parameter(torch.full((len(GROUPS),), GATE_INIT))\n"}
,{"stream_name":"stdout","time":157.330403066,"data":"        group_of = torch.zeros(cpt_size, dtype=torch.long)\n"}
,{"stream_name":"stdout","time":157.330405288,"data":"        for g, indices in enumerate(GROUPS):\n"}
,{"stream_name":"stdout","time":157.330407573,"data":"            group_of[indices] = g\n"}
,{"stream_name":"stdout","time":157.330409773,"data":"        self.register_buffer(\"group_of\", group_of, persistent=False)\n"}
,{"stream_name":"stdout","time":157.330412117,"data":"\n"}
,{"stream_name":"stdout","time":157.330414177,"data":"    def energies(self, images):\n"}
,{"stream_name":"stdout","time":157.330416422,"data":"        \"\"\"E_class [B, C] và E_concept [B, K, 2] của tác giả; E_concept[..., s] là năng lượng của trạng thái s.\"\"\"\n"}
,{"stream_name":"stdout","time":157.330419144,"data":"        emb = self.backbone(images)\n"}
,{"stream_name":"stdout","time":157.330421301,"data":"        e_class, _, e_concept = self.energy_model(emb, None, True, use_cy=False)\n"}
,{"stream_name":"stdout","time":157.330423506,"data":"        return e_class, e_concept\n"}
,{"stream_name":"stdout","time":157.330425685,"data":"\n"}
,{"stream_name":"stdout","time":157.330427715,"data":"    def gate(self, verified_groups):\n"}
,{"stream_name":"stdout","time":157.33042992,"data":"        w = torch.exp(-torch.cat([self.gate_steps.new_zeros(1), torch.cumsum(F.softplus(self.gate_steps), 0)]))\n"}
,{"stream_name":"stdout","time":157.330432166,"data":"        return w[verified_groups]\n"}
,{"stream_name":"stdout","time":157.330434311,"data":"\n"}
,{"stream_name":"stdout","time":157.330436345,"data":"    def global_score(self, concepts):\n"}
,{"stream_name":"stdout","time":157.330438489,"data":"        \"\"\"−E_global(c, y) cho mọi y: [B, C].\"\"\"\n"}
,{"stream_name":"stdout","time":157.33044084,"data":"        return self.label_bias + concepts.float() @ self.theta.t()\n"}
,{"stream_name":"stdout","time":157.330443034,"data":"\n"}
,{"stream_name":"stdout","time":157.330445089,"data":"    def posterior(self, e_class, e_concept, mask=None, values=None, class_weight=None):\n"}
,{"stream_name":"stdout","time":157.330447317,"data":"        \"\"\"log p(y | x, c_S) [B, C] và p(c_k = 1 | x, c_S) [B, K]; tính ở FP32.\"\"\"\n"}
,{"stream_name":"stdout","time":157.330449716,"data":"        e_class, e_concept = e_class.float(), e_concept.float()\n"}
,{"stream_name":"stdout","time":157.330451915,"data":"        t1 = -e_concept[..., 1][:, None, :] + self.theta[None]          # [B, C, K]\n"}
,{"stream_name":"stdout","time":157.330454147,"data":"        t0 = (-e_concept[..., 0])[:, None, :].expand_as(t1)\n"}
,{"stream_name":"stdout","time":157.330456368,"data":"        per_concept = torch.logaddexp(t0, t1)\n"}
,{"stream_name":"stdout","time":157.330458522,"data":"        p1_given_y = torch.sigmoid(t1 - t0)\n"}
,{"stream_name":"stdout","time":157.330460709,"data":"        if mask is not None:\n"}
,{"stream_name":"stdout","time":157.330462978,"data":"            observed = torch.where(values[:, None, :].bool(), t1, t0)\n"}
,{"stream_name":"stdout","time":157.330465199,"data":"            per_concept = torch.where(mask[:, None, :], observed, per_concept)\n"}
,{"stream_name":"stdout","time":157.330467426,"data":"            p1_given_y = torch.where(mask[:, None, :], values[:, None, :].float(), p1_given_y)\n"}
,{"stream_name":"stdout","time":157.330471756,"data":"        weight = 1.0 if class_weight is None else class_weight.float()[:, None]\n"}
,{"stream_name":"stdout","time":157.33047469,"data":"        log_p_y = (-weight * e_class + self.label_bias[None] + per_concept.sum(-1)).log_softmax(-1)\n"}
,{"stream_name":"stdout","time":157.330477028,"data":"        return log_p_y, (log_p_y.exp()[:, :, None] * p1_given_y).sum(1)\n"}
,{"stream_name":"stdout","time":157.330479249,"data":"\n"}
,{"stream_name":"stdout","time":157.330481298,"data":"\n"}
,{"stream_name":"stdout","time":157.330483338,"data":"def ga_losses(model, loss_label, loss_concept, images, labels, concepts, weights=(3, 1, 1)):\n"}
,{"stream_name":"stdout","time":157.330485583,"data":"    \"\"\"Loss của GA-ECBM cho một batch.\n"}
,{"stream_name":"stdout","time":157.330487863,"data":"\n"}
,{"stream_name":"stdout","time":157.330489939,"data":"    Trả về (loss train, loss validation kiểu tác giả, các thành phần, (e_class, e_concept, concept sạch)).\n"}
,{"stream_name":"stdout","time":157.330492437,"data":"    Loss gốc 3 : 1 : 1 gọi đúng hàm loss và cy_augment của tác giả. Trong forward gốc, cy_augment sửa thẳng tensor concept\n"}
,{"stream_name":"stdout","time":157.330494989,"data":"    của batch, nên L_xc của tác giả cũng tính trên concept đã xáo trộn; ở đây giữ nguyên hành vi đó cho phần loss gốc.\n"}
,{"stream_name":"stdout","time":157.330502638,"data":"    Ba loss mới dùng concept sạch (bản sao lấy trước khi xáo trộn).\n"}
,{"stream_name":"stdout","time":157.330505063,"data":"    \"\"\"\n"}
,{"stream_name":"stdout","time":157.330507217,"data":"    clean = concepts.clone()\n"}
,{"stream_name":"stdout","time":157.33050939,"data":"    head = model.energy_model\n"}
,{"stream_name":"stdout","time":157.33051154,"data":"    e_class, e_concept = model.energies(images)\n"}
,{"stream_name":"stdout","time":157.330513714,"data":"    perturbed = head.cy_augment(c_gt=concepts.unsqueeze(-1), permute_ratio=head.cy_concept_perturb_prob,\n"}
,{"stream_name":"stdout","time":157.33051598,"data":"                                permute_prob=head.cy_sample_perturb_prob).squeeze(-1)\n"}
,{"stream_name":"stdout","time":157.330518219,"data":"    loss_xy = loss_label(e_class, labels)\n"}
,{"stream_name":"stdout","time":157.330520389,"data":"    loss_cy = loss_label(-model.global_score(perturbed), labels)       # EBMLoss_label nhận năng lượng\n"}
,{"stream_name":"stdout","time":157.330522772,"data":"    loss_xc = loss_concept(e_concept, concepts)\n"}
,{"stream_name":"stdout","time":157.330524941,"data":"    w_xy, w_xc, w_cy = weights\n"}
,{"stream_name":"stdout","time":157.330527097,"data":"    base = w_xy * loss_xy + w_xc * loss_xc + w_cy * loss_cy\n"}
,{"stream_name":"stdout","time":157.330529313,"data":"\n"}
,{"stream_name":"stdout","time":157.330531379,"data":"    device_type = \"cuda\" if images.is_cuda else \"cpu\"\n"}
,{"stream_name":"stdout","time":157.330533742,"data":"    with torch.autocast(device_type=device_type, enabled=False):\n"}
,{"stream_name":"stdout","time":157.330535947,"data":"        count, n_groups = len(labels), len(GROUPS)\n"}
,{"stream_name":"stdout","time":157.330538135,"data":"        log_p_y, p_c = model.posterior(e_class, e_concept)\n"}
,{"stream_name":"stdout","time":157.330540352,"data":"        joint = F.nll_loss(log_p_y, labels) + F.binary_cross_entropy(p_c.clamp(1e-6, 1 - 1e-6), clean.float())\n"}
,{"stream_name":"stdout","time":157.330542655,"data":"        groups = torch.rand(count, n_groups, device=images.device) \u003c torch.rand(count, 1, device=images.device)\n"}
,{"stream_name":"stdout","time":157.330547291,"data":"        drop = torch.rand(count, device=images.device) \u003c 0.5                  # nửa số ca tắt hẳn nhánh ảnh\n"}
,{"stream_name":"stdout","time":157.330575167,"data":"        k = groups.sum(1)\n"}
,{"stream_name":"stdout","time":157.330579129,"data":"        w_k = torch.where(drop, torch.zeros_like(k, dtype=torch.float), model.gate(k))\n"}
,{"stream_name":"stdout","time":157.330583194,"data":"        log_int, _ = model.posterior(e_class, e_concept, groups[:, model.group_of], clean, w_k)\n"}
,{"stream_name":"stdout","time":157.330586721,"data":"        loss_int = F.nll_loss(log_int, labels, reduction=\"none\")\n"}
,{"stream_name":"stdout","time":157.330590673,"data":"        extra = torch.multinomial((~groups).float() + 1e-9, 1).squeeze(1)      # xác minh thêm 1 nhóm\n"}
,{"stream_name":"stdout","time":157.330594758,"data":"        groups_more = groups.clone()\n"}
,{"stream_name":"stdout","time":157.330598122,"data":"        groups_more[torch.arange(count, device=images.device), extra] = True\n"}
,{"stream_name":"stdout","time":157.330601518,"data":"        k_more = groups_more.sum(1)\n"}
,{"stream_name":"stdout","time":157.330604813,"data":"        w_more = torch.where(drop, torch.zeros_like(k_more, dtype=torch.float), model.gate(k_more))\n"}
,{"stream_name":"stdout","time":157.330608225,"data":"        log_more, _ = model.posterior(e_class, e_concept, groups_more[:, model.group_of], clean, w_more)\n"}
,{"stream_name":"stdout","time":157.330611739,"data":"        mono = F.relu(F.nll_loss(log_more, labels, reduction=\"none\") - loss_int).mean()\n"}
,{"stream_name":"stdout","time":157.330615298,"data":"    total = base + joint + loss_int.mean() + mono\n"}
,{"stream_name":"stdout","time":157.330618608,"data":"    val_like = loss_xc + loss_xy + loss_cy                                   # như validation_step của tác giả\n"}
,{"stream_name":"stdout","time":157.330622193,"data":"    parts = {\"xy\": loss_xy, \"xc\": loss_xc, \"cy\": loss_cy, \"joint\": joint, \"int\": loss_int.mean(), \"mono\": mono}\n"}
,{"stream_name":"stdout","time":157.330626194,"data":"    return total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c)\n"}
,{"stream_name":"stdout","time":157.330629584,"data":"\n"}
,{"stream_name":"stdout","time":157.330632613,"data":"# ===== ga_litmodel.py (file mới) =====\n"}
,{"stream_name":"stdout","time":157.330635862,"data":"\"\"\"LightningModule của GA-ECBM: kế thừa LitModel của tác giả, giữ nguyên optimizer, scheduler và cách log.\n"}
,{"stream_name":"stdout","time":157.33063983,"data":"\n"}
,{"stream_name":"stdout","time":157.330648789,"data":"main.py chỉ đổi một dòng import để dùng lớp này; mọi thứ khác (dữ liệu, sampler, ModelCheckpoint, số epoch) giữ nguyên.\n"}
,{"stream_name":"stdout","time":157.330651747,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":157.330653897,"data":"import logging\n"}
,{"stream_name":"stdout","time":157.330656001,"data":"import os\n"}
,{"stream_name":"stdout","time":157.330658865,"data":"\n"}
,{"stream_name":"stdout","time":157.330687813,"data":"import torch\n"}
,{"stream_name":"stdout","time":157.33069143,"data":"\n"}
,{"stream_name":"stdout","time":157.330695031,"data":"from LitModel import LitModel\n"}
,{"stream_name":"stdout","time":157.330702111,"data":"from ga_ecbm import GATE_INIT, GROUPS, GAECBM, ga_losses\n"}
,{"stream_name":"stdout","time":157.330706021,"data":"\n"}
,{"stream_name":"stdout","time":157.330709139,"data":"\n"}
,{"stream_name":"stdout","time":157.330712155,"data":"def _accuracy(pred, target):\n"}
,{"stream_name":"stdout","time":157.33071537,"data":"    return (pred == target).float().mean()\n"}
,{"stream_name":"stdout","time":157.330722364,"data":"\n"}
,{"stream_name":"stdout","time":157.330725548,"data":"\n"}
,{"stream_name":"stdout","time":157.330728651,"data":"class GALitModel(LitModel):\n"}
,{"stream_name":"stdout","time":157.330731869,"data":"    def __init__(self, logdir, args):\n"}
,{"stream_name":"stdout","time":157.330735085,"data":"        super().__init__(logdir, args)\n"}
,{"stream_name":"stdout","time":157.330738333,"data":"        self.network = GAECBM(args=args, emb_size=args.emb_size, cpt_size=args.cpt_size, hid_size=args.hid_size,\n"}
,{"stream_name":"stdout","time":157.330741789,"data":"                              n_classes=args.n_classes)\n"}
,{"stream_name":"stdout","time":157.33074513,"data":"        logging.info(\"GA-ECBM: gate_init=%s, groups=%d\", GATE_INIT, len(GROUPS))   # dấu để notebook nhận ra lần chạy GA\n"}
,{"stream_name":"stdout","time":157.330748866,"data":"\n"}
,{"stream_name":"stdout","time":157.330751972,"data":"    def _step(self, batch, stage):\n"}
,{"stream_name":"stdout","time":157.33075522,"data":"        images, labels, concepts = batch\n"}
,{"stream_name":"stdout","time":157.330759026,"data":"        total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c) = ga_losses(\n"}
,{"stream_name":"stdout","time":157.330764026,"data":"            self.network, self.loss_label, self.loss_concept, images, labels, concepts,\n"}
,{"stream_name":"stdout","time":157.330771106,"data":"            (self.lambda_xy, self.lambda_xc, self.lambda_cy))\n"}
,{"stream_name":"stdout","time":157.330786706,"data":"        pred_c_direct = torch.argmin(e_concept, 2)\n"}
,{"stream_name":"stdout","time":157.330790851,"data":"        pred_c_post = (p_c \u003e 0.5).long()\n"}
,{"stream_name":"stdout","time":157.330794608,"data":"        values = {\n"}
,{"stream_name":"stdout","time":157.330798432,"data":"            # như tác giả: đọc trực tiếp năng lượng, concept so với tensor của batch (đã bị cy_augment sửa)\n"}
,{"stream_name":"stdout","time":157.330802986,"data":"            f\"accuracy_{stage}_y_xy\": _accuracy(torch.argmin(e_class, 1), labels),\n"}
,{"stream_name":"stdout","time":157.330806571,"data":"            f\"accuracy_{stage}_c\": _accuracy(pred_c_direct, concepts),\n"}
,{"stream_name":"stdout","time":157.330810037,"data":"            f\"accuracy_{stage}_c_overall\": (pred_c_direct == concepts).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":157.330813512,"data":"            # GA-ECBM: suy luận chính xác, so với concept sạch\n"}
,{"stream_name":"stdout","time":157.330816937,"data":"            f\"accuracy_{stage}_y_post\": _accuracy(log_p_y.argmax(1), labels),\n"}
,{"stream_name":"stdout","time":157.330820369,"data":"            f\"accuracy_{stage}_c_post\": _accuracy(pred_c_post, clean),\n"}
,{"stream_name":"stdout","time":157.330823774,"data":"            f\"accuracy_{stage}_c_overall_post\": (pred_c_post == clean).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":157.330827217,"data":"        }\n"}
,{"stream_name":"stdout","time":157.3308304,"data":"        for name, value in values.items():\n"}
,{"stream_name":"stdout","time":157.330833639,"data":"            self.log(name, value, on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":157.330836923,"data":"        return total, val_like, parts, values\n"}
,{"stream_name":"stdout","time":157.330840204,"data":"\n"}
,{"stream_name":"stdout","time":157.330843226,"data":"    def training_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":157.3308464,"data":"        total, _, parts, _ = self._step(batch, \"train\")\n"}
,{"stream_name":"stdout","time":157.330856446,"data":"        self.log(\"epoch_loss\", total, on_epoch=True)                 # scheduler của tác giả theo dõi epoch_loss_epoch\n"}
,{"stream_name":"stdout","time":157.330865366,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":157.330868462,"data":"            self.log(f\"epoch_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":157.330883091,"data":"        if batch_idx == 0:\n"}
,{"stream_name":"stdout","time":157.330887065,"data":"            w = self.network.gate(torch.tensor([0, 7, 14, 28], device=self.device))\n"}
,{"stream_name":"stdout","time":157.330890897,"data":"            self.log(\"gate_w_7\", w[1], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":157.330895004,"data":"            self.log(\"gate_w_28\", w[3], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":157.330899039,"data":"        return total\n"}
,{"stream_name":"stdout","time":157.330902327,"data":"\n"}
,{"stream_name":"stdout","time":157.330905441,"data":"    def validation_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":157.330908666,"data":"        _, val_like, parts, _ = self._step(batch, \"val\")\n"}
,{"stream_name":"stdout","time":157.330912089,"data":"        self.log(\"epoch_val_loss\", val_like, on_epoch=True)         # ModelCheckpoint theo dõi khóa này, như tác giả\n"}
,{"stream_name":"stdout","time":157.330916313,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":157.330919685,"data":"            self.log(f\"epoch_val_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":157.330923107,"data":"        return val_like\n"}
,{"stream_name":"stdout","time":157.330926304,"data":"\n"}
,{"stream_name":"stdout","time":157.330929397,"data":"    def test_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":157.330932556,"data":"        _, _, _, values = self._step(batch, \"test\")\n"}
,{"stream_name":"stdout","time":157.330935968,"data":"        return [values[\"accuracy_test_c_overall_post\"].item(), values[\"accuracy_test_c_post\"].item(),\n"}
,{"stream_name":"stdout","time":157.330939554,"data":"                values[\"accuracy_test_y_xy\"].item(), values[\"accuracy_test_y_post\"].item()]\n"}
,{"stream_name":"stdout","time":157.330943047,"data":"\n"}
,{"stream_name":"stdout","time":157.330946121,"data":"    def test_epoch_end(self, outputs):\n"}
,{"stream_name":"stdout","time":157.330949354,"data":"        mean = torch.tensor(outputs).mean(0)\n"}
,{"stream_name":"stdout","time":157.330952699,"data":"        for name, value in zip((\"accuracy_test_c_overall_post\", \"accuracy_test_c_post\", \"accuracy_test_y_xy\",\n"}
,{"stream_name":"stdout","time":157.330961114,"data":"                                \"accuracy_test_y_post\"), mean):\n"}
,{"stream_name":"stdout","time":157.330964443,"data":"            logging.info(\"%s: %s\", name, float(value))\n"}
,{"stream_name":"stdout","time":157.330978372,"data":"\n"}
,{"stream_name":"stdout","time":158.808630536,"data":"Sai lệch lớn nhất so với duyệt hết tổ hợp: 5.96e-07\n"}
