,{"stream_name":"stdout","time":148.190848805,"data":"# ===== ga_ecbm.py (file mới) =====\n"}
,{"stream_name":"stdout","time":148.190852975,"data":"\"\"\"GA-ECBM (Gated Additive ECBM) đặt trong code ECBM gốc (xmed-lab/ECBM, commit d38c43a).\n"}
,{"stream_name":"stdout","time":148.190857858,"data":"\n"}
,{"stream_name":"stdout","time":148.190861554,"data":"Giữ nguyên của tác giả: backbone ResNet101, nhánh ảnh → nhãn E_class và nhánh ảnh → concept E_concept của EBM_GL.\n"}
,{"stream_name":"stdout","time":148.190866324,"data":"Thay: E_global(c, y) = −(b_y + Σ_k θ_{y,k}·c_k), tức bảng điểm cộng tính thay cho MLP trên cả vector concept.\n"}
,{"stream_name":"stdout","time":148.190870837,"data":"Nhờ cộng tính, p(y | x, concept đã biết) và p(c_k | x, …) tính chính xác bằng công thức đóng, không cần tối ưu gradient.\n"}
,{"stream_name":"stdout","time":148.190875766,"data":"Khi can thiệp k nhóm concept, nhánh ảnh nhân với cổng w(k) = exp(−Σ_{j≤k} softplus(a_j)), w(0) = 1.\n"}
,{"stream_name":"stdout","time":148.190880372,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":148.1908842,"data":"import os\n"}
,{"stream_name":"stdout","time":148.1908886,"data":"\n"}
,{"stream_name":"stdout","time":148.190892663,"data":"import torch\n"}
,{"stream_name":"stdout","time":148.190898767,"data":"import torch.nn as nn\n"}
,{"stream_name":"stdout","time":148.190902743,"data":"import torch.nn.functional as F\n"}
,{"stream_name":"stdout","time":148.190906975,"data":"\n"}
,{"stream_name":"stdout","time":148.19091085,"data":"from data.cub import CONCEPT_GROUP_MAP\n"}
,{"stream_name":"stdout","time":148.190914957,"data":"from networks.EBM import ECBM\n"}
,{"stream_name":"stdout","time":148.190918847,"data":"\n"}
,{"stream_name":"stdout","time":148.190923087,"data":"GROUPS = [list(indices) for indices in CONCEPT_GROUP_MAP.values()]   # 28 nhóm, như phần can thiệp theo nhóm của tác giả\n"}
,{"stream_name":"stdout","time":148.190927552,"data":"GATE_INIT = float(os.environ.get(\"GA_GATE_INIT\", \"-3.1\"))             # softplus(−3.1) ≈ 0.044 → w(28) ≈ 0.29\n"}
,{"stream_name":"stdout","time":148.19093227,"data":"\n"}
,{"stream_name":"stdout","time":148.190936952,"data":"\n"}
,{"stream_name":"stdout","time":148.190940705,"data":"class GAECBM(ECBM):\n"}
,{"stream_name":"stdout","time":148.190944522,"data":"    def __init__(self, args, emb_size, cpt_size, hid_size, n_classes):\n"}
,{"stream_name":"stdout","time":148.19096079,"data":"        super().__init__(args, emb_size=emb_size, cpt_size=cpt_size, hid_size=hid_size, n_classes=n_classes)\n"}
,{"stream_name":"stdout","time":148.190964852,"data":"        head = self.energy_model\n"}
,{"stream_name":"stdout","time":148.190972338,"data":"        del head.concept_proj, head.fc_c, head.classifier_cy        # MLP E_global của tác giả: không dùng nữa\n"}
,{"stream_name":"stdout","time":148.190976617,"data":"        self.theta = nn.Parameter(torch.zeros(n_classes, cpt_size))  # θ_{y,k}: điểm của concept k = 1 cho loài y\n"}
,{"stream_name":"stdout","time":148.190981008,"data":"        self.label_bias = nn.Parameter(torch.zeros(n_classes))       # b_y\n"}
,{"stream_name":"stdout","time":148.190984846,"data":"        self.gate_steps = nn.Parameter(torch.full((len(GROUPS),), GATE_INIT))\n"}
,{"stream_name":"stdout","time":148.190988742,"data":"        group_of = torch.zeros(cpt_size, dtype=torch.long)\n"}
,{"stream_name":"stdout","time":148.190993264,"data":"        for g, indices in enumerate(GROUPS):\n"}
,{"stream_name":"stdout","time":148.19099692,"data":"            group_of[indices] = g\n"}
,{"stream_name":"stdout","time":148.191000656,"data":"        self.register_buffer(\"group_of\", group_of, persistent=False)\n"}
,{"stream_name":"stdout","time":148.191004888,"data":"\n"}
,{"stream_name":"stdout","time":148.19100838,"data":"    def energies(self, images):\n"}
,{"stream_name":"stdout","time":148.191012181,"data":"        \"\"\"E_class [B, C] và E_concept [B, K, 2] của tác giả; E_concept[..., s] là năng lượng của trạng thái s.\"\"\"\n"}
,{"stream_name":"stdout","time":148.191016765,"data":"        emb = self.backbone(images)\n"}
,{"stream_name":"stdout","time":148.191020517,"data":"        e_class, _, e_concept = self.energy_model(emb, None, True, use_cy=False)\n"}
,{"stream_name":"stdout","time":148.191024306,"data":"        return e_class, e_concept\n"}
,{"stream_name":"stdout","time":148.191027967,"data":"\n"}
,{"stream_name":"stdout","time":148.191031379,"data":"    def gate(self, verified_groups):\n"}
,{"stream_name":"stdout","time":148.191035075,"data":"        w = torch.exp(-torch.cat([self.gate_steps.new_zeros(1), torch.cumsum(F.softplus(self.gate_steps), 0)]))\n"}
,{"stream_name":"stdout","time":148.191039077,"data":"        return w[verified_groups]\n"}
,{"stream_name":"stdout","time":148.191042662,"data":"\n"}
,{"stream_name":"stdout","time":148.191046099,"data":"    def global_score(self, concepts):\n"}
,{"stream_name":"stdout","time":148.191056638,"data":"        \"\"\"−E_global(c, y) cho mọi y: [B, C].\"\"\"\n"}
,{"stream_name":"stdout","time":148.191060659,"data":"        return self.label_bias + concepts.float() @ self.theta.t()\n"}
,{"stream_name":"stdout","time":148.191064362,"data":"\n"}
,{"stream_name":"stdout","time":148.191067962,"data":"    def posterior(self, e_class, e_concept, mask=None, values=None, class_weight=None):\n"}
,{"stream_name":"stdout","time":148.19107213,"data":"        \"\"\"log p(y | x, c_S) [B, C] và p(c_k = 1 | x, c_S) [B, K]; tính ở FP32.\"\"\"\n"}
,{"stream_name":"stdout","time":148.191076172,"data":"        e_class, e_concept = e_class.float(), e_concept.float()\n"}
,{"stream_name":"stdout","time":148.191080086,"data":"        t1 = -e_concept[..., 1][:, None, :] + self.theta[None]          # [B, C, K]\n"}
,{"stream_name":"stdout","time":148.191083866,"data":"        t0 = (-e_concept[..., 0])[:, None, :].expand_as(t1)\n"}
,{"stream_name":"stdout","time":148.19108741,"data":"        per_concept = torch.logaddexp(t0, t1)\n"}
,{"stream_name":"stdout","time":148.191104461,"data":"        p1_given_y = torch.sigmoid(t1 - t0)\n"}
,{"stream_name":"stdout","time":148.191107748,"data":"        if mask is not None:\n"}
,{"stream_name":"stdout","time":148.191111137,"data":"            observed = torch.where(values[:, None, :].bool(), t1, t0)\n"}
,{"stream_name":"stdout","time":148.191117743,"data":"            per_concept = torch.where(mask[:, None, :], observed, per_concept)\n"}
,{"stream_name":"stdout","time":148.191121463,"data":"            p1_given_y = torch.where(mask[:, None, :], values[:, None, :].float(), p1_given_y)\n"}
,{"stream_name":"stdout","time":148.19112514,"data":"        weight = 1.0 if class_weight is None else class_weight.float()[:, None]\n"}
,{"stream_name":"stdout","time":148.191129691,"data":"        log_p_y = (-weight * e_class + self.label_bias[None] + per_concept.sum(-1)).log_softmax(-1)\n"}
,{"stream_name":"stdout","time":148.191133645,"data":"        return log_p_y, (log_p_y.exp()[:, :, None] * p1_given_y).sum(1)\n"}
,{"stream_name":"stdout","time":148.19113724300001,"data":"\n"}
,{"stream_name":"stdout","time":148.191140535,"data":"\n"}
,{"stream_name":"stdout","time":148.191143775,"data":"def ga_losses(model, loss_label, loss_concept, images, labels, concepts, weights=(3, 1, 1)):\n"}
,{"stream_name":"stdout","time":148.191147497,"data":"    \"\"\"Loss của GA-ECBM cho một batch.\n"}
,{"stream_name":"stdout","time":148.191151077,"data":"\n"}
,{"stream_name":"stdout","time":148.19115518,"data":"    Trả về (loss train, loss validation kiểu tác giả, các thành phần, (e_class, e_concept, concept sạch)).\n"}
,{"stream_name":"stdout","time":148.191159467,"data":"    Loss gốc 3 : 1 : 1 gọi đúng hàm loss và cy_augment của tác giả. Trong forward gốc, cy_augment sửa thẳng tensor concept\n"}
,{"stream_name":"stdout","time":148.191163792,"data":"    của batch, nên L_xc của tác giả cũng tính trên concept đã xáo trộn; ở đây giữ nguyên hành vi đó cho phần loss gốc.\n"}
,{"stream_name":"stdout","time":148.191167985,"data":"    Ba loss mới dùng concept sạch (bản sao lấy trước khi xáo trộn).\n"}
,{"stream_name":"stdout","time":148.191172011,"data":"    \"\"\"\n"}
,{"stream_name":"stdout","time":148.191175477,"data":"    clean = concepts.clone()\n"}
,{"stream_name":"stdout","time":148.191178845,"data":"    head = model.energy_model\n"}
,{"stream_name":"stdout","time":148.191182576,"data":"    e_class, e_concept = model.energies(images)\n"}
,{"stream_name":"stdout","time":148.19118617,"data":"    perturbed = head.cy_augment(c_gt=concepts.unsqueeze(-1), permute_ratio=head.cy_concept_perturb_prob,\n"}
,{"stream_name":"stdout","time":148.191190035,"data":"                                permute_prob=head.cy_sample_perturb_prob).squeeze(-1)\n"}
,{"stream_name":"stdout","time":148.191194721,"data":"    loss_xy = loss_label(e_class, labels)\n"}
,{"stream_name":"stdout","time":148.19119817199999,"data":"    loss_cy = loss_label(-model.global_score(perturbed), labels)       # EBMLoss_label nhận năng lượng\n"}
,{"stream_name":"stdout","time":148.191201985,"data":"    loss_xc = loss_concept(e_concept, concepts)\n"}
,{"stream_name":"stdout","time":148.191205443,"data":"    w_xy, w_xc, w_cy = weights\n"}
,{"stream_name":"stdout","time":148.19120876,"data":"    base = w_xy * loss_xy + w_xc * loss_xc + w_cy * loss_cy\n"}
,{"stream_name":"stdout","time":148.191212293,"data":"\n"}
,{"stream_name":"stdout","time":148.191215473,"data":"    device_type = \"cuda\" if images.is_cuda else \"cpu\"\n"}
,{"stream_name":"stdout","time":148.19121912,"data":"    with torch.autocast(device_type=device_type, enabled=False):\n"}
,{"stream_name":"stdout","time":148.19122299,"data":"        count, n_groups = len(labels), len(GROUPS)\n"}
,{"stream_name":"stdout","time":148.191226423,"data":"        log_p_y, p_c = model.posterior(e_class, e_concept)\n"}
,{"stream_name":"stdout","time":148.191229848,"data":"        joint = F.nll_loss(log_p_y, labels) + F.binary_cross_entropy(p_c.clamp(1e-6, 1 - 1e-6), clean.float())\n"}
,{"stream_name":"stdout","time":148.191236751,"data":"        groups = torch.rand(count, n_groups, device=images.device) \u003c torch.rand(count, 1, device=images.device)\n"}
,{"stream_name":"stdout","time":148.191240869,"data":"        drop = torch.rand(count, device=images.device) \u003c 0.5                  # nửa số ca tắt hẳn nhánh ảnh\n"}
,{"stream_name":"stdout","time":148.191244792,"data":"        k = groups.sum(1)\n"}
,{"stream_name":"stdout","time":148.19124816,"data":"        w_k = torch.where(drop, torch.zeros_like(k, dtype=torch.float), model.gate(k))\n"}
,{"stream_name":"stdout","time":148.191252196,"data":"        log_int, _ = model.posterior(e_class, e_concept, groups[:, model.group_of], clean, w_k)\n"}
,{"stream_name":"stdout","time":148.191255858,"data":"        loss_int = F.nll_loss(log_int, labels, reduction=\"none\")\n"}
,{"stream_name":"stdout","time":148.191259465,"data":"        extra = torch.multinomial((~groups).float() + 1e-9, 1).squeeze(1)      # xác minh thêm 1 nhóm\n"}
,{"stream_name":"stdout","time":148.191263432,"data":"        groups_more = groups.clone()\n"}
,{"stream_name":"stdout","time":148.191266993,"data":"        groups_more[torch.arange(count, device=images.device), extra] = True\n"}
,{"stream_name":"stdout","time":148.191270535,"data":"        k_more = groups_more.sum(1)\n"}
,{"stream_name":"stdout","time":148.191273976,"data":"        w_more = torch.where(drop, torch.zeros_like(k_more, dtype=torch.float), model.gate(k_more))\n"}
,{"stream_name":"stdout","time":148.191277783,"data":"        log_more, _ = model.posterior(e_class, e_concept, groups_more[:, model.group_of], clean, w_more)\n"}
,{"stream_name":"stdout","time":148.1912819,"data":"        mono = F.relu(F.nll_loss(log_more, labels, reduction=\"none\") - loss_int).mean()\n"}
,{"stream_name":"stdout","time":148.191285666,"data":"    total = base + joint + loss_int.mean() + mono\n"}
,{"stream_name":"stdout","time":148.191289146,"data":"    val_like = loss_xc + loss_xy + loss_cy                                   # như validation_step của tác giả\n"}
,{"stream_name":"stdout","time":148.19129301,"data":"    parts = {\"xy\": loss_xy, \"xc\": loss_xc, \"cy\": loss_cy, \"joint\": joint, \"int\": loss_int.mean(), \"mono\": mono}\n"}
,{"stream_name":"stdout","time":148.191297388,"data":"    return total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c)\n"}
,{"stream_name":"stdout","time":148.191300968,"data":"\n"}
,{"stream_name":"stdout","time":148.191304171,"data":"# ===== ga_litmodel.py (file mới) =====\n"}
,{"stream_name":"stdout","time":148.191307614,"data":"\"\"\"LightningModule của GA-ECBM: kế thừa LitModel của tác giả, giữ nguyên optimizer, scheduler và cách log.\n"}
,{"stream_name":"stdout","time":148.191311648,"data":"\n"}
,{"stream_name":"stdout","time":148.191314926,"data":"main.py chỉ đổi một dòng import để dùng lớp này; mọi thứ khác (dữ liệu, sampler, ModelCheckpoint, số epoch) giữ nguyên.\n"}
,{"stream_name":"stdout","time":148.191319081,"data":"\"\"\"\n"}
,{"stream_name":"stdout","time":148.191322526,"data":"import logging\n"}
,{"stream_name":"stdout","time":148.191325882,"data":"import os\n"}
,{"stream_name":"stdout","time":148.19132925,"data":"\n"}
,{"stream_name":"stdout","time":148.191332499,"data":"import torch\n"}
,{"stream_name":"stdout","time":148.191335835,"data":"\n"}
,{"stream_name":"stdout","time":148.191339128,"data":"from LitModel import LitModel\n"}
,{"stream_name":"stdout","time":148.191342877,"data":"from ga_ecbm import GATE_INIT, GROUPS, GAECBM, ga_losses\n"}
,{"stream_name":"stdout","time":148.191346426,"data":"\n"}
,{"stream_name":"stdout","time":148.191352449,"data":"\n"}
,{"stream_name":"stdout","time":148.191355792,"data":"def _accuracy(pred, target):\n"}
,{"stream_name":"stdout","time":148.191359309,"data":"    return (pred == target).float().mean()\n"}
,{"stream_name":"stdout","time":148.191362855,"data":"\n"}
,{"stream_name":"stdout","time":148.191366202,"data":"\n"}
,{"stream_name":"stdout","time":148.191369545,"data":"class GALitModel(LitModel):\n"}
,{"stream_name":"stdout","time":148.191372983,"data":"    def __init__(self, logdir, args):\n"}
,{"stream_name":"stdout","time":148.191376462,"data":"        super().__init__(logdir, args)\n"}
,{"stream_name":"stdout","time":148.191379958,"data":"        self.network = GAECBM(args=args, emb_size=args.emb_size, cpt_size=args.cpt_size, hid_size=args.hid_size,\n"}
,{"stream_name":"stdout","time":148.191383806,"data":"                              n_classes=args.n_classes)\n"}
,{"stream_name":"stdout","time":148.191387394,"data":"        logging.info(\"GA-ECBM: gate_init=%s, groups=%d\", GATE_INIT, len(GROUPS))   # dấu để notebook nhận ra lần chạy GA\n"}
,{"stream_name":"stdout","time":148.19139147,"data":"\n"}
,{"stream_name":"stdout","time":148.19139494,"data":"    def _step(self, batch, stage):\n"}
,{"stream_name":"stdout","time":148.191398718,"data":"        images, labels, concepts = batch\n"}
,{"stream_name":"stdout","time":148.191402457,"data":"        total, val_like, parts, (e_class, e_concept, clean, log_p_y, p_c) = ga_losses(\n"}
,{"stream_name":"stdout","time":148.191406055,"data":"            self.network, self.loss_label, self.loss_concept, images, labels, concepts,\n"}
,{"stream_name":"stdout","time":148.191409694,"data":"            (self.lambda_xy, self.lambda_xc, self.lambda_cy))\n"}
,{"stream_name":"stdout","time":148.19141325,"data":"        pred_c_direct = torch.argmin(e_concept, 2)\n"}
,{"stream_name":"stdout","time":148.191434607,"data":"        pred_c_post = (p_c \u003e 0.5).long()\n"}
,{"stream_name":"stdout","time":148.191441798,"data":"        values = {\n"}
,{"stream_name":"stdout","time":148.191445256,"data":"            # như tác giả: đọc trực tiếp năng lượng, concept so với tensor của batch (đã bị cy_augment sửa)\n"}
,{"stream_name":"stdout","time":148.191449669,"data":"            f\"accuracy_{stage}_y_xy\": _accuracy(torch.argmin(e_class, 1), labels),\n"}
,{"stream_name":"stdout","time":148.19145346,"data":"            f\"accuracy_{stage}_c\": _accuracy(pred_c_direct, concepts),\n"}
,{"stream_name":"stdout","time":148.191457337,"data":"            f\"accuracy_{stage}_c_overall\": (pred_c_direct == concepts).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":148.191461106,"data":"            # GA-ECBM: suy luận chính xác, so với concept sạch\n"}
,{"stream_name":"stdout","time":148.191464807,"data":"            f\"accuracy_{stage}_y_post\": _accuracy(log_p_y.argmax(1), labels),\n"}
,{"stream_name":"stdout","time":148.19146839,"data":"            f\"accuracy_{stage}_c_post\": _accuracy(pred_c_post, clean),\n"}
,{"stream_name":"stdout","time":148.191472028,"data":"            f\"accuracy_{stage}_c_overall_post\": (pred_c_post == clean).all(1).float().mean(),\n"}
,{"stream_name":"stdout","time":148.191475686,"data":"        }\n"}
,{"stream_name":"stdout","time":148.191479185,"data":"        for name, value in values.items():\n"}
,{"stream_name":"stdout","time":148.191482623,"data":"            self.log(name, value, on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":148.191486134,"data":"        return total, val_like, parts, values\n"}
,{"stream_name":"stdout","time":148.191489768,"data":"\n"}
,{"stream_name":"stdout","time":148.191498235,"data":"    def training_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":148.191502202,"data":"        total, _, parts, _ = self._step(batch, \"train\")\n"}
,{"stream_name":"stdout","time":148.191506049,"data":"        self.log(\"epoch_loss\", total, on_epoch=True)                 # scheduler của tác giả theo dõi epoch_loss_epoch\n"}
,{"stream_name":"stdout","time":148.191509931,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":148.191530492,"data":"            self.log(f\"epoch_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":148.191534418,"data":"        if batch_idx == 0:\n"}
,{"stream_name":"stdout","time":148.191538006,"data":"            w = self.network.gate(torch.tensor([0, 7, 14, 28], device=self.device))\n"}
,{"stream_name":"stdout","time":148.191541791,"data":"            self.log(\"gate_w_7\", w[1], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":148.191545666,"data":"            self.log(\"gate_w_28\", w[3], on_epoch=True, on_step=False)\n"}
,{"stream_name":"stdout","time":148.191549552,"data":"        return total\n"}
,{"stream_name":"stdout","time":148.191553136,"data":"\n"}
,{"stream_name":"stdout","time":148.191557282,"data":"    def validation_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":148.191561025,"data":"        _, val_like, parts, _ = self._step(batch, \"val\")\n"}
,{"stream_name":"stdout","time":148.191564948,"data":"        self.log(\"epoch_val_loss\", val_like, on_epoch=True)         # ModelCheckpoint theo dõi khóa này, như tác giả\n"}
,{"stream_name":"stdout","time":148.19156975,"data":"        for name, value in parts.items():\n"}
,{"stream_name":"stdout","time":148.191573471,"data":"            self.log(f\"epoch_val_loss_{name}\", value, on_epoch=True)\n"}
,{"stream_name":"stdout","time":148.191577324,"data":"        return val_like\n"}
,{"stream_name":"stdout","time":148.191594422,"data":"\n"}
,{"stream_name":"stdout","time":148.191597687,"data":"    def test_step(self, batch, batch_idx):\n"}
,{"stream_name":"stdout","time":148.191601059,"data":"        _, _, _, values = self._step(batch, \"test\")\n"}
,{"stream_name":"stdout","time":148.191604987,"data":"        return [values[\"accuracy_test_c_overall_post\"].item(), values[\"accuracy_test_c_post\"].item(),\n"}
,{"stream_name":"stdout","time":148.19160878,"data":"                values[\"accuracy_test_y_xy\"].item(), values[\"accuracy_test_y_post\"].item()]\n"}
,{"stream_name":"stdout","time":148.191612592,"data":"\n"}
,{"stream_name":"stdout","time":148.191615793,"data":"    def test_epoch_end(self, outputs):\n"}
,{"stream_name":"stdout","time":148.191619262,"data":"        mean = torch.tensor(outputs).mean(0)\n"}
,{"stream_name":"stdout","time":148.19162266,"data":"        for name, value in zip((\"accuracy_test_c_overall_post\", \"accuracy_test_c_post\", \"accuracy_test_y_xy\",\n"}
,{"stream_name":"stdout","time":148.191626626,"data":"                                \"accuracy_test_y_post\"), mean):\n"}
,{"stream_name":"stdout","time":148.191630283,"data":"            logging.info(\"%s: %s\", name, float(value))\n"}
,{"stream_name":"stdout","time":148.191633878,"data":"\n"}
